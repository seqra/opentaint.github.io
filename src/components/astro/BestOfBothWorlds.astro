          </div>
          <div>
            <span class="best-worlds-value-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M7 3.5h7l3 3V20.5H7zM14 3.5v3h3" /><path d="m9.5 14 1.75 1.75L15 12" /></svg>
            </span>
