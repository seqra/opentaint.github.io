---
const features = [
  {
    title: "Learn on demand, search on every scan",
    description:
      "The agent learns the attack surface, trust boundaries, vulnerability patterns, and opaque code behavior when new context is needed. The engine applies the resulting taint rules and consults the resulting dataflow summaries on every scan without spending model tokens again.",
  },
  {
    title: "Make every security review executable.",
    description:
      "The agent turns vulnerability patterns into AST-pattern taint rules and opaque code behavior into dataflow summaries. Both become versioned, reviewable analysis artifacts.",
  },
  {
    title: "Fast scans. Fewer false alarms. Fewer missed findings.",
    description:
      "The engine runs formal inter-procedural dataflow analysis, applying taint rules and consulting dataflow summaries as it tracks tainted values across procedures, fields, aliases, async code, and persistence layers at scale.",
  },
  {
    title: "Open source, customizable, and self-hosted.",
    description:
      "Engine, AST-pattern rules, agent skills, and CI integrations ship under Apache 2.0 and MIT — an AI-ready open source alternative to Semgrep Pro and CodeQL.",
  },
];

const pressures = [
  {
    title: "Did the agent write a vulnerability into code you never reviewed?",
    description:
      "The output can look finished and pass its tests while an untrusted value crosses helpers, fields, or libraries you never read before reaching a dangerous operation. OpenTaint reports the complete source-to-sink taint trace before the change becomes invisible security debt.",
    value: "Generate fast. Verify before merge.",
  },
  {
    title: "Is the feature done if a vulnerability ships with it?",
    description:
      "A feature that passes its tests can still carry security debt into production, where the fix competes with roadmap work and incident response. OpenTaint finds forbidden source-to-sink flows in the pull request and reports the taint trace before that debt becomes an emergency.",
    value: "Make secure part of done.",
  },
  {
    title: "Will your security agent find tomorrow what it found today?",
    description:
      "An agent can discover a vulnerability pattern once, then miss it on the next nondeterministic review. OpenTaint records that pattern as a versioned AST-pattern taint rule that the engine applies on every scan.",
    value: "Turn every discovery into deterministic coverage.",
  },
  {
    title: "How many times will you pay an agent to review the same risk?",
    description:
      "Your last security review already paid to understand the application’s trust boundaries, vulnerability patterns, and opaque code behavior. Every scan that starts from zero spends tokens rebuilding security context you already owned. OpenTaint records that context as taint rules and dataflow summaries, then applies the rules and consults the summaries on every change.",
    value: "Spend tokens only when new context must be learned. Keep every scan fast enough to enforce.",
  },
];

const proofs = [
  {
    href: "/blog/semgrep-vs-codeql-vs-opentaint",
    title: "Detection depth, compared.",
    description:
      "See Semgrep, CodeQL, and OpenTaint run against five progressively harder Java XSS cases, from direct returns to builders with virtual dispatch.",
  },
  {
    href: "/blog/conductor-rce-cve-2026-58138",
    title: "A real unauthenticated RCE, from endpoint to exploit.",
    description:
      "Follow CVE-2026-58138 through Conductor and GraalVM, see why four stock scans missed it, and how the agent turned the review into a tested taint rule and reusable dataflow summary.",
  },
];

const comparisonRows = [
  { depth: "Direct return", semgrep: "✓ / ✓", codeql: "✓", opentaint: "✓ / ✓" },
  { depth: "Local dataflow", semgrep: "× / ✓", codeql: "✓", opentaint: "✓ / ✓" },
  { depth: "Inter-procedural", semgrep: "× / ✓", codeql: "✓", opentaint: "✓ / ✓" },
  { depth: "Field sensitivity", semgrep: "× / ◐", codeql: "◐", opentaint: "✓ / ✓" },
  { depth: "Virtual dispatch", semgrep: "× / ×", codeql: "◐", opentaint: "✓ / ✓" },
];
---

<section class="band band-tint" aria-labelledby="what-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">What OpenTaint does</p>
      <h2 id="what-heading" class="section-heading mt-5">Taint analysis that turns agent discoveries into deterministic coverage</h2>
      <p class="section-subtitle max-w-[68ch]">
        The open source taint analysis engine for the AI era. Formal inter-procedural dataflow analysis tracks tainted values across your application. AI agents add project-specific AST-pattern taint rules and dataflow summaries. The customizable, self-hosted engine applies those rules and consults those summaries on every scan without burning model tokens again.
      </p>
      <p class="mt-5 max-w-[68ch] font-mono text-sm font-medium leading-7 text-foreground lg:text-[15px]">
        An AI-ready open source alternative to Semgrep Pro and CodeQL.
      </p>
    </div>

    <figure class="mt-10 border-y border-border-strong lg:mt-14" aria-labelledby="workflow-caption">
      <figcaption id="workflow-caption" class="sr-only">The agent records vulnerability patterns as taint rules and opaque code behavior as dataflow summaries. The OpenTaint engine applies the rules and consults the summaries on every change.</figcaption>
      <div class="grid lg:grid-cols-[1fr_1.35fr_1fr]">
        <div class="py-7 lg:pr-10 lg:py-10">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">01 · Learn when needed</p>
          <h3 class="mt-4 font-mono text-lg font-semibold text-foreground">Security agent</h3>
          <p class="mt-3 max-w-[40ch] font-mono text-sm leading-7 text-muted-foreground">Understands application context and investigates new vulnerability patterns.</p>
          <p class="mt-5 font-mono text-xs text-muted-foreground">Expensive and adaptive</p>
        </div>

        <div class="border-y border-border bg-background py-7 lg:border-x lg:border-y-0 lg:px-10 lg:py-10">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">Durable output</p>
          <div class="mt-5 font-mono text-sm">
            <div class="grid grid-cols-[1fr_auto] gap-4 border-b border-border pb-4">
              <span class="font-medium text-foreground">rules/xss-builder.yaml</span>
              <span class="text-right text-xs text-muted-foreground">AST-pattern taint rule</span>
            </div>
            <div class="grid grid-cols-[1fr_auto] gap-4 pt-4">
              <span class="font-medium text-foreground">summaries/graalvm.yaml</span>
              <span class="text-right text-xs text-muted-foreground">Dataflow summary</span>
            </div>
          </div>
          <p class="mt-5 font-mono text-xs text-muted-foreground">Versioned, reviewable, reusable</p>
        </div>

        <div class="py-7 lg:pl-10 lg:py-10">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">02 · Search every change</p>
          <h3 class="mt-4 font-mono text-lg font-semibold text-foreground">OpenTaint engine</h3>
          <p class="mt-3 max-w-[40ch] font-mono text-sm leading-7 text-muted-foreground">Applies taint rules and consults dataflow summaries while tracking tainted values across the application.</p>
          <p class="mt-5 font-mono text-xs text-muted-foreground">Cheap and deterministic</p>
        </div>
      </div>
    </figure>
  </div>
</section>

<section class="band" aria-labelledby="security-debt-heading">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">Why now</p>
        <h2 id="security-debt-heading" class="section-heading mt-5">Application security is the new tech debt</h2>
      </div>
      <p class="section-subtitle mt-0 max-w-[68ch]">
        AI makes code cheaper to produce and harder to fully review. Security work moves downstream into review queues, remediation backlogs, and incident response, while attackers automate discovery too. Application security becomes tech debt an attacker can force you to repay. You start paying for that debt long before an incident.
      </p>
    </div>

    <ul class="mt-10 border-t border-border-strong lg:mt-14" aria-labelledby="security-debt-heading">
      {pressures.map((pressure, index) => (
        <li class="grid gap-4 border-b border-border py-7 md:grid-cols-[0.85fr_1.15fr] md:gap-10 lg:py-9">
          <div class="flex gap-4">
            <span class="mt-1 font-mono text-[11px] font-semibold tracking-[0.14em] text-primary">0{index + 1}</span>
            <h3 class="max-w-[34ch] font-mono text-base font-semibold leading-7 text-foreground lg:text-lg lg:leading-8">{pressure.title}</h3>
          </div>
          <div class="md:pl-4">
            <p class="max-w-[68ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{pressure.description}</p>
            <p class="mt-3 font-mono text-sm font-semibold leading-6 text-foreground lg:text-[15px]">{pressure.value}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band band-tint" aria-labelledby="how-heading">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">The economics</p>
        <h2 id="how-heading" class="section-heading mt-5">Learn on demand, search on every scan</h2>
      </div>
      <p class="section-subtitle mt-0 max-w-[68ch]">
        Learning application context is expensive and unpredictable. Once the agent records vulnerability patterns as taint rules and opaque code behavior as dataflow summaries, the engine can apply that knowledge cheaply and deterministically.
      </p>
    </div>

    <ul class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:mt-14 lg:grid-cols-4" aria-labelledby="how-heading">
      {features.map((feature, index) => (
        <li class="border-t border-border-strong pt-5">
          <p class="font-mono text-[11px] font-semibold tracking-[0.14em] text-primary">0{index + 1}</p>
          <h3 class="mt-4 font-mono text-[15px] font-semibold leading-6 text-foreground lg:text-base">{feature.title}</h3>
          <p class="mt-3 font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{feature.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-16 border-t border-border-strong pt-14 lg:mt-24 lg:pt-20" aria-labelledby="proof-heading">
      <div class="max-w-2xl">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">Proof, not promises</p>
        <h2 id="proof-heading" class="section-heading mt-5">See what the engine catches</h2>
        <p class="section-subtitle max-w-[68ch]">Claims about detection depth need traces and results you can inspect.</p>
      </div>

      <div class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-16">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">Five-case comparison</p>
          <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{proofs[0].title}</h3>
          <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{proofs[0].description}</p>
          <a href={proofs[0].href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the comparison →</a>
        </div>

        <div class="overflow-x-auto border border-border-strong bg-background scrollbar-thin">
          <table class="w-full table-fixed border-collapse font-mono text-left text-[10px] sm:min-w-[600px] sm:table-auto sm:text-xs">
            <thead>
              <tr class="border-b border-border-strong text-muted-foreground">
                <th scope="col" class="w-[40%] px-2 py-3 font-medium sm:w-auto sm:px-4">Analysis depth</th>
                <th scope="col" class="w-[20%] px-2 py-3 font-medium sm:w-auto sm:px-4"><span class="sm:hidden">SG Code</span><span class="hidden sm:inline">Semgrep Code</span></th>
                <th scope="col" class="w-[18%] px-2 py-3 font-medium sm:w-auto sm:px-4">CodeQL</th>
                <th scope="col" class="w-[22%] bg-primary/5 px-2 py-3 font-semibold text-primary sm:w-auto sm:px-4">OpenTaint</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class="border-b border-border last:border-b-0">
                  <th scope="row" class="px-2 py-3 font-medium text-foreground sm:px-4">{row.depth}</th>
                  <td class="whitespace-nowrap px-2 py-3 text-muted-foreground sm:px-4">{row.semgrep}</td>
                  <td class="whitespace-nowrap px-2 py-3 text-muted-foreground sm:px-4">{row.codeql}</td>
                  <td class="whitespace-nowrap bg-primary/5 px-2 py-3 font-semibold text-primary sm:px-4">{row.opentaint}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="border-t border-border px-4 py-3 font-mono text-[10px] leading-5 text-muted-foreground">✓ correct · ◐ partial · × missed · paired results show pattern / taint rules</p>
        </div>
      </div>

      <div class="mt-14 grid gap-8 border-t border-border pt-14 lg:mt-20 lg:grid-cols-[1.28fr_0.72fr] lg:items-center lg:gap-16 lg:pt-20">
        <a href={proofs[1].href} class="group block overflow-hidden border border-border-strong bg-background">
          <img src="/pictures/blog/conductor-rce/report-overview.png" alt="OpenTaint report showing two Conductor RCE findings and their source-to-sink taint traces" class="aspect-[36/25] w-full object-cover object-top transition-transform duration-500 motion-reduce:transition-none group-hover:scale-[1.01]" loading="lazy" width="1440" height="1000" />
        </a>
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">CVE-2026-58138 · Case study</p>
          <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{proofs[1].title}</h3>
          <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{proofs[1].description}</p>
          <a href={proofs[1].href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the case study →</a>
        </div>
      </div>
    </div>
  </div>
</section>
