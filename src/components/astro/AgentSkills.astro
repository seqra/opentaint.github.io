---
import AgentPipeline from "@/components/astro/AgentPipeline.astro";

const skills = {
  href: "/blog/appsec-agent/",
  description:
    "AppSec Agent builds and scans, writes rules and models, triages findings, and generates proof-of-concept checks.",
};
---

<section class="band agent-skills-band" aria-labelledby="agent-skills-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">The agent skills</p>
      <h2 id="agent-skills-heading" class="section-heading">An application-security workflow</h2>
    </div>

    <div class="section-content">
      <div class="mx-auto max-w-3xl lg:text-center">
        <h3 class="font-mono text-[1.375rem] font-semibold leading-8 text-foreground sm:text-2xl">Fifteen composable skills, one workflow</h3>
        <p class="mt-4 font-mono text-base leading-7 text-muted-foreground">{skills.description}</p>
        <a href={skills.href} class="mt-6 inline-flex font-mono text-[15px] font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground lg:text-base">Read the release post</a>
      </div>

      <div class="mt-8">
        <AgentPipeline />
      </div>
    </div>
  </div>
</section>
