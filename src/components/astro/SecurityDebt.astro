---
const pressures = [
  {
    question: "Would you notice the agent slipping a vulnerability into code you never reviewed?",
    percent: 45,
    metric: "introduced a known security flaw",
    segment: "known flaw",
    remainder: "no known flaw observed",
    response: "OpenTaint checks generated code against explicit security rules.",
    source: "Veracode 2025",
    href: "https://www.veracode.com/resources/analyst-reports/2025-genai-code-security-report/",
  },
  {
    question: "How long will you keep betting nobody will bother to exploit your code?",
    percent: 31,
    metric: "of breaches started with vulnerability exploitation",
    segment: "vulnerability exploitation",
    remainder: "other initial-access vectors",
    response: "OpenTaint shows which untrusted paths can reach dangerous operations.",
    source: "Verizon DBIR 2026",
    href: "https://www.verizon.com/about/news/breach-industry-wide-dbir-finds",
  },
  {
    question: "Will tomorrow’s security review catch what today’s review found?",
    percent: 86,
    metric: "of unmatched reports did not recur in all five identical reviews",
    segment: "did not recur every time",
    remainder: "recurred in all five reviews",
    caveat: "Unmatched LLM-only report signatures, not independently confirmed vulnerabilities.",
    response: "OpenTaint enacts discoveries as taint rules for consistent subsequent scans.",
    source: "Snyk VulnBench",
    href: "https://snyk.io/blog/snyk-vulnbench-js-1-0-llm-security-review-repeatability/",
  },
];
---

<section class="band" aria-labelledby="security-debt-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header max-w-6xl">
      <h2 id="security-debt-heading" class="section-heading lg:whitespace-nowrap">Application security is the new tech debt</h2>
    </div>

    <ol class="section-content border-t border-border-strong">
      {pressures.map((pressure) => (
        <li class="grid gap-8 border-b border-border-strong py-8 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16 lg:py-10">
          <h3 class="max-w-[46ch] font-mono text-base font-semibold leading-7 text-foreground lg:text-lg lg:leading-8">{pressure.question}</h3>

          <figure>
            <figcaption class="flex items-baseline gap-4 font-mono text-foreground">
              <strong class="text-4xl tracking-[-0.06em] lg:text-5xl">{pressure.percent}%</strong>
              <span class="max-w-[38ch] text-sm font-semibold leading-6 lg:text-base">{pressure.metric}</span>
            </figcaption>
            <div class="mt-6 flex h-3 overflow-hidden bg-border" role="img" aria-label={`${pressure.percent}% ${pressure.metric}`}>
              <span class="h-full bg-primary" style={`width:${pressure.percent}%`}></span>
              <span class="h-full bg-muted" style={`width:${100 - pressure.percent}%`}></span>
            </div>
            <div class="mt-2 flex justify-between gap-4 font-mono text-[9px] leading-4 text-muted-foreground">
              <span>{pressure.segment}, {pressure.percent}%</span>
              <span class="text-right">{pressure.remainder}, {100 - pressure.percent}%</span>
            </div>
            {pressure.caveat && <p class="mt-3 font-mono text-[9px] leading-5 text-muted-foreground">{pressure.caveat}</p>}
            <div class="mt-4 flex flex-col gap-2 border-l-2 border-primary pl-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <p class="font-mono text-xs leading-6 text-muted-foreground">{pressure.response}</p>
              <a href={pressure.href} target="_blank" rel="noreferrer" class="shrink-0 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-primary underline decoration-primary/30 underline-offset-4">{pressure.source}</a>
            </div>
          </figure>
        </li>
      ))}

      <li class="grid gap-8 border-b border-border-strong py-8 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16 lg:py-10">
        <h3 class="max-w-[46ch] font-mono text-base font-semibold leading-7 text-foreground lg:text-lg lg:leading-8">How much money will you waste asking a security agent to review the same parts of your application again?</h3>
        <figure>
          <figcaption class="sr-only">Anthropic spent under $20,000 across 1,000 repeated searches</figcaption>
          <div class="grid grid-cols-3 border-y border-border-strong font-mono">
            <div class="py-4 pr-4">
              <strong class="block text-xl text-foreground lg:text-2xl">1,000</strong>
              <span class="mt-1 block text-[9px] leading-4 text-muted-foreground">repeated searches</span>
            </div>
            <div class="border-x border-border-strong px-4 py-4 text-center">
              <strong class="block text-xl text-foreground lg:text-2xl">&lt;$20K</strong>
              <span class="mt-1 block text-[9px] leading-4 text-muted-foreground">total spend</span>
            </div>
            <div class="py-4 pl-4 text-right">
              <strong class="block text-xl text-foreground lg:text-2xl">&lt;$20</strong>
              <span class="mt-1 block text-[9px] leading-4 text-muted-foreground">average per search</span>
            </div>
          </div>
          <p class="mt-3 font-mono text-[9px] leading-5 text-muted-foreground">The successful run was identifiable only afterward.</p>
          <div class="mt-4 flex flex-col gap-2 border-l-2 border-primary pl-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <p class="font-mono text-xs leading-6 text-muted-foreground">OpenTaint applies enacted rules without repeating model reasoning already captured in the specification.</p>
            <a href="https://www.anthropic.com/research/mythos-preview" target="_blank" rel="noreferrer" class="shrink-0 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-primary underline decoration-primary/30 underline-offset-4">Anthropic Mythos</a>
          </div>
        </figure>
      </li>
    </ol>
  </div>
</section>
