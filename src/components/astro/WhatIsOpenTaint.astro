---
import { Code } from "astro-expressive-code/components";
import { VideoDemo } from "@/components/VideoDemo";

const discoveries = [
  { label: "Trust boundary", text: "Unauthenticated workflow input reaches the script evaluators" },
  { label: "Vulnerability pattern", text: "Untrusted text passed to <code>Context.eval()</code> on a context built with <code>allowAllAccess(true)</code>" },
  { label: "Opaque behavior", text: "<code>Builder.option()</code> returns the same builder" },
];

const features = [
  {
    title: "Fast scans, fewer false alarms, fewer missed findings",
    description:
      "Formal inter-procedural dataflow analysis tracks tainted values across procedures, fields, aliases, async code, and persistence layers at scale.",
  },
  {
    title: "Open source, customizable, and self-hosted",
    description:
      "Engine, AST-pattern rules, agent skills, and CI integrations ship under Apache 2.0 and MIT — an AI-ready open source alternative to Semgrep Pro and CodeQL.",
  },
];

const pressures = [
  {
    title: "Did the agent write a vulnerability into code you never reviewed?",
    description:
      "It can look finished and pass its tests while an untrusted value crosses helpers, fields, and libraries nobody read. OpenTaint reports the whole source-to-sink trace before that becomes invisible security debt.",
    value: "Generate fast. Verify before merge.",
  },
  {
    title: "Is the feature done if a vulnerability ships with it?",
    description:
      "A feature that passes its tests can still carry security debt into production, where the fix competes with roadmap work. OpenTaint catches forbidden flows in the pull request, not in the incident.",
    value: "Make secure part of done.",
  },
  {
    title: "Will your security agent find tomorrow what it found today?",
    description:
      "An agent can find a pattern once, then miss it on the next nondeterministic review. OpenTaint records it as a versioned taint rule the engine applies on every scan.",
    value: "Turn every discovery into deterministic coverage.",
  },
  {
    title: "How many times will you pay an agent to review the same risk?",
    description:
      "Your last review already paid to learn the trust boundaries, vulnerability patterns, and opaque library behavior. Every scan that starts from zero buys that context again. OpenTaint records it as taint rules and dependency models, then applies both on every change.",
    value: "Spend tokens only when new context must be learned. Keep every scan fast enough to enforce.",
  },
];

const proof = {
  href: "/blog/semgrep-vs-codeql-vs-opentaint",
  title: "Detection depth, compared",
  description:
    "See Semgrep, CodeQL, and OpenTaint run against five progressively harder Java XSS cases, from direct returns to builders with virtual dispatch.",
};

/* The three moves the appsec-agent skill makes, named by the skills that do
   them. Titles and skill names track the engine README. */
const skills = {
  href: "/blog/appsec-agent",
  title: "The agent that writes the rules",
  description:
    "Skills that pair an LLM agent with the engine. It maps your attack surface, models the library methods the engine cannot see, writes rules specific to your code, and confirms a finding by exploiting it. The engine takes it from there.",
  steps: [
    {
      title: "Map the attack surface",
      detail: "Find the entry points and trust boundaries this application actually has.",
      skill: "discover-attack-surface",
    },
    {
      title: "Write and test the rule",
      detail: "Turn the pattern into a taint rule with positive and negative samples that prove it.",
      skill: "create-rule",
    },
    {
      title: "Confirm by exploiting",
      detail: "Build a proof-of-concept against the running app before anyone is asked to fix it.",
      skill: "generate-poc",
    },
  ],
};

/* Coverage matrix. Columns pair each tool with the analysis mode it was run in,
   so a miss is attributed to a mode rather than hidden behind a slashed pair.
   State is encoded by fill (solid / half / empty), never by color alone. */
const coverageColumns = [
  { tool: "Semgrep Code", mode: "patterns" },
  { tool: "Semgrep Code", mode: "taint rules" },
  { tool: "CodeQL", mode: "taint rules" },
  { tool: "OpenTaint", mode: "patterns", accent: true },
  { tool: "OpenTaint", mode: "taint rules", accent: true },
];

const coverageRows = [
  { depth: "Direct return", cells: ["full", "full", "full", "full", "full"] },
  { depth: "Local dataflow", cells: ["miss", "full", "full", "full", "full"] },
  { depth: "Inter-procedural", cells: ["miss", "full", "full", "full", "full"] },
  { depth: "Field sensitivity", cells: ["miss", "partial", "partial", "full", "full"] },
  { depth: "Virtual dispatch", cells: ["miss", "miss", "partial", "full", "full"] },
];

const coverageStates = {
  full: { label: "Detected", fill: "bg-current" },
  partial: { label: "Partial", fill: "bg-[linear-gradient(to_right,currentColor_50%,transparent_50%)]" },
  miss: { label: "Missed", fill: "bg-transparent" },
};

/* Both artifacts come from the CVE-2026-58138 reproduction kit. Fully-qualified
   names are shortened to keep the lines readable; everything else is verbatim. */
const artifacts = [
  {
    label: "Taint rule",
    file: ".opentaint/rules/graalvm-polyglot-sinks.yaml",
    caption: "The vulnerability pattern the agent found: attacker-controlled script text evaluated on a context with full host access.",
    code: `id: graalvm-polyglot-eval
languages: [java]
mode: taint
pattern-sinks:
  - patterns:
      - pattern: (Context $CTX).eval($LANG, $SOURCE)
      - focus-metavariable: $SOURCE
      # Only a context with full host access is RCE.
      - pattern-inside: |
          Context $CTX = $B
            .allowAllAccess(true).build();
          ...`,
  },
  {
    label: "Dependency model",
    file: ".opentaint/config/org.graalvm.polyglot.yaml",
    caption: "The library behavior the engine cannot see: a fluent builder that mutates and returns the same instance, so taint survives the chain.",
    code: `language: java
passThrough:
  - function: Context$Builder#option
    copy:
      - from: this
        to: result

  - function: Source$Builder#cached
    copy:
      - from: this
        to: result`,
  },
];

/* The reported flow, source first. `where` says what the value crosses, not
   where it lives — file and line belong in the report, not on a landing page. */
const traceSteps = [
  { role: "Source", label: "HTTP request", where: "Unauthenticated workflow input" },
  { role: "Step", label: "Task scheduling", where: "Across the workflow executor" },
  { role: "Step", label: "Executor lambda", where: "Captured, then run on another thread" },
  { role: "Sink", label: "Context.eval", where: "Evaluated with full host access" },
];

/* Cadence rail: which step runs the model and which steps run on CPU. The
   markers encode kind, not cost — nothing here is a magnitude. `phase` links a
   stage to the panel below it, which lights up together on hover or focus. */
const cadence = [
  { phase: "learn", label: "Security review", detail: "The agent learns the application, then commits taint rules and dependency models." },
  { phase: "search", label: "Next commit", detail: "Engine scan, no model." },
  { phase: "search", label: "Commit after that", detail: "Engine scan, no model." },
  { phase: "search", label: "Every commit after", detail: "Engine scan, no model." },
];

const economics = [
  {
    phase: "Learn",
    owner: "Security agent",
    cadence: "When new context appears",
    compute: "Model reasoning",
    output: "Taint rules and dependency models",
  },
  {
    phase: "Search",
    owner: "OpenTaint engine",
    cadence: "On every change",
    compute: "Deterministic CPU analysis",
    output: "Source-to-sink taint traces",
  },
];
---

<section class="band band-tint" aria-labelledby="what-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">What OpenTaint does</p>
      <h2 id="what-heading" class="section-heading mt-5">Taint analysis that turns agent discoveries into deterministic coverage</h2>
      <p class="section-subtitle max-w-[68ch]">
        Agents capture new vulnerability patterns as AST-pattern taint rules, and opaque library behavior as dependency models. The engine applies both on every scan, without burning model tokens again.
      </p>
      <p class="mt-5 max-w-[68ch] font-mono text-sm font-medium leading-7 text-foreground lg:text-[15px]">
        An AI-ready open source alternative to Semgrep Pro and CodeQL.
      </p>
    </div>

    <figure class="mt-10 overflow-hidden border-y border-border-strong bg-background lg:mt-14" aria-labelledby="workflow-caption">
      <figcaption id="workflow-caption" class="flex flex-col gap-3 border-b border-border px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">One review becomes continuous coverage</span>
        <a href="/blog/conductor-rce-cve-2026-58138" class="font-mono text-xs font-semibold text-foreground underline decoration-primary/30 underline-offset-4 transition-colors hover:text-primary">Real artifacts from CVE-2026-58138</a>
      </figcaption>

      <div class="p-5 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-primary">01</span>
            <span class="text-foreground">Agent discovers</span>
          </p>
          <p class="font-mono text-[11px] leading-5 text-muted-foreground">Model reasoning, on demand</p>
        </div>

        <div class="mt-7 grid gap-6 md:grid-cols-3 md:gap-0">
          {discoveries.map((item, index) => (
            <div class:list={[
              "reveal",
              index > 0 && "border-t border-border pt-6 md:border-l md:border-t-0 md:pl-8 md:pt-0",
              index < discoveries.length - 1 && "md:pr-8",
            ]}>
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground">{item.label}</p>
              <p class="mt-3 max-w-[36ch] font-mono text-[15px] font-semibold leading-7 text-foreground" set:html={item.text}></p>
            </div>
          ))}
        </div>
      </div>

      <div class="border-t border-border p-5 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-primary">02</span>
            <span class="text-foreground">Agent writes</span>
          </p>
          <p class="font-mono text-[11px] leading-5 text-muted-foreground">Committed to your repo, versioned, reviewed, and tested like code</p>
        </div>

        <div class="mt-7 grid gap-6 lg:grid-cols-2 lg:items-start">
          {artifacts.map((artifact) => (
            <article class="reveal flex min-w-0 flex-col overflow-hidden border border-border-strong transition-colors duration-300 hover:border-primary/60 motion-reduce:transition-none">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border bg-code-header px-4 py-3">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">{artifact.label}</span>
                <span class="font-mono text-[11px] text-muted-foreground">{artifact.file.split("/").pop()}</span>
              </div>
              <Code code={artifact.code} lang="yaml" class="artifact-code" />
              <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-5 text-muted-foreground">{artifact.caption}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="border-t border-border p-5 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-primary">03</span>
            <span class="text-foreground">OpenTaint scans every change</span>
          </p>
          <p class="font-mono text-[11px] leading-5 text-muted-foreground">Deterministic CPU analysis, on every scan</p>
        </div>

        <div class="mt-7 grid gap-8 lg:grid-cols-[1.5fr_0.5fr] lg:gap-10">
          <figure class="reveal min-w-0">
            <a href="/reports/conductor-cve-2026-58138.html" class="group relative block overflow-hidden border border-border-strong bg-background transition-colors duration-300 hover:border-primary/60 focus-visible:border-primary motion-reduce:transition-none">
              <span class="pointer-events-none absolute bottom-0 right-0 z-10 translate-y-full bg-primary px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none">Open the report</span>
              <img src="/pictures/report/trace-light.webp" alt="OpenTaint report with the tainted script flow selected and its steps listed below the source" class="w-full transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.01] dark:hidden" loading="lazy" width="1600" height="1000" />
              <img src="/pictures/report/trace-dark.webp" alt="OpenTaint report with the tainted script flow selected and its steps listed below the source" class="hidden w-full transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.01] dark:block" loading="lazy" width="1600" height="1000" />
            </a>
            <figcaption class="mt-3 font-mono text-[11px] leading-5 text-muted-foreground">
              Every finding opens to the flow that produced it, step by step.
            </figcaption>
          </figure>

          <div class="reveal flex min-w-0 flex-col border border-border-strong">
            <p class="border-b border-border bg-code-header px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">
              Reported taint trace
            </p>

            <ol class="trace flex-1 px-4 py-5 font-mono">
              {traceSteps.map((step, index) => (
                <li class="trace-step relative pl-7" style={`--step-index:${index}`}>
                  <span class:list={[
                    "absolute left-0 top-[7px] h-2.5 w-2.5 border",
                    step.role === "Source" || step.role === "Sink" ? "border-primary bg-primary" : "border-border-strong bg-background",
                  ]} aria-hidden="true"></span>
                  {index < traceSteps.length - 1 && (
                    <span class="trace-rail absolute bottom-0 left-[4.5px] top-[19px] w-px bg-border-strong" aria-hidden="true"></span>
                  )}
                  <span class:list={[
                    "block text-[10px] uppercase tracking-[0.14em]",
                    step.role === "Step" ? "text-muted-foreground" : "text-primary",
                  ]}>{step.role}</span>
                  <span class="mt-1 block text-[13px] font-semibold leading-5 text-foreground">{step.label}</span>
                  <span class="mb-5 mt-1 block text-[11px] leading-5 text-muted-foreground">{step.where}</span>
                </li>
              ))}
            </ol>

            <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-5 text-muted-foreground">
              182 steps in full, reported on the pull request that introduces the flow.
            </p>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<section class="band" aria-labelledby="security-debt-heading">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">Why now</p>
        <h2 id="security-debt-heading" class="section-heading mt-5">Application security is the new tech debt</h2>
      </div>
      <p class="section-subtitle mt-0 max-w-[68ch]">
        AI makes code cheaper to produce and harder to fully review. Security work piles up in review queues and remediation backlogs while attackers automate discovery too — tech debt an attacker can force you to repay, long before an incident.
      </p>
    </div>

    <ul class="mt-10 grid border-y border-border-strong md:grid-cols-2 lg:mt-14" aria-labelledby="security-debt-heading">
      {pressures.map((pressure, index) => (
        <li class:list={[
          "reveal py-7 md:py-9",
          index !== pressures.length - 1 && "border-b border-border",
          index === 2 && "md:border-b-0",
          index % 2 === 0 ? "md:pr-10" : "md:border-l md:border-border md:pl-10",
        ]}>
          <span class="font-mono text-[11px] font-semibold tracking-[0.14em] text-primary">0{index + 1}</span>
          <h3 class="mt-5 max-w-[36ch] font-mono text-base font-semibold leading-7 text-foreground lg:text-lg lg:leading-8">{pressure.title}</h3>
          <p class="mt-4 max-w-[58ch] font-mono text-sm leading-7 text-muted-foreground">{pressure.description}</p>
          <p class="mt-5 border-l-2 border-primary pl-3 font-mono text-xs font-semibold leading-5 text-foreground lg:text-sm lg:leading-6">{pressure.value}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band band-tint" aria-labelledby="how-heading">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">The economics</p>
        <h2 id="how-heading" class="section-heading mt-5">Learn on demand, search on every scan</h2>
      </div>
      <p class="section-subtitle mt-0 max-w-[68ch]">
        Use model reasoning only when the application reveals new security context. Everything already learned becomes deterministic analysis that runs on CPU for every change.
      </p>
    </div>

    <figure class="cadence reveal mt-10 lg:mt-14" data-cadence>
      <figcaption class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">One review, then every commit after it</figcaption>
      <ol class="mt-6 flex items-start gap-0 overflow-x-auto border-b border-border-strong pb-6 scrollbar-thin">
        {cadence.map((item, index) => (
          <li
            class:list={[
              "cadence-stage relative flex shrink-0 flex-col gap-3 sm:shrink",
              index === 0 ? "w-[14rem] sm:flex-[1.5]" : "w-[9rem] sm:flex-1",
            ]}
            style={`--stage-index:${index}`}
            data-phase={item.phase}
            tabindex="0"
          >
            <span class="flex items-center">
              <span class:list={[
                "cadence-node h-3 w-3 shrink-0 border transition-colors duration-300 motion-reduce:transition-none",
                index === 0 ? "border-primary bg-primary" : "border-border-strong bg-background",
              ]} aria-hidden="true"></span>
              {index < cadence.length - 1 && <span class="cadence-line h-px w-full bg-border" aria-hidden="true"></span>}
            </span>
            <span class="pr-5">
              <span class:list={["block font-mono text-xs font-semibold leading-5", index === 0 ? "text-foreground" : "text-muted-foreground"]}>{item.label}</span>
              <span class="mt-1 block font-mono text-[11px] leading-5 text-muted-foreground">{item.detail}</span>
            </span>
          </li>
        ))}
      </ol>
    </figure>

    <div class="mt-12 grid border-y border-border-strong md:grid-cols-2 lg:mt-16" aria-label="Learning and scanning economics">
      {economics.map((item, index) => (
        <article
          class:list={["economics-panel reveal py-7 md:py-9", index === 0 ? "border-b border-border md:border-b-0 md:border-r md:pr-10" : "md:pl-10"]}
          data-phase={index === 0 ? "learn" : "search"}
        >
          <div class="flex items-baseline justify-between gap-5">
            <h3 class="font-mono text-xl font-semibold text-foreground">{item.phase}</h3>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">0{index + 1}</p>
          </div>
          <dl class="mt-6 grid grid-cols-[7.5rem_1fr] gap-x-5 gap-y-3 font-mono text-xs leading-5 sm:text-sm sm:leading-6">
            <dt class="text-muted-foreground">Who</dt><dd class="font-medium text-foreground">{item.owner}</dd>
            <dt class="text-muted-foreground">When</dt><dd class="font-medium text-foreground">{item.cadence}</dd>
            <dt class="text-muted-foreground">Compute</dt><dd class="font-medium text-foreground">{item.compute}</dd>
            <dt class="text-muted-foreground">Leaves behind</dt><dd class="font-medium text-foreground">{item.output}</dd>
          </dl>
        </article>
      ))}
    </div>

    <ul class="mt-12 grid gap-x-14 gap-y-10 md:grid-cols-2 lg:mt-16" aria-labelledby="how-heading">
      {features.map((feature, index) => (
        <li class="reveal border-t border-border-strong pt-5">
          <p class="font-mono text-[11px] font-semibold tracking-[0.14em] text-primary">0{index + 1}</p>
          <h3 class="mt-4 font-mono text-[15px] font-semibold leading-6 text-foreground lg:text-base">{feature.title}</h3>
          <p class="mt-3 font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{feature.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-16 border-t border-border-strong pt-14 lg:mt-24 lg:pt-20" aria-labelledby="proof-heading">
      <div class="max-w-2xl">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">Proof, not promises</p>
        <h2 id="proof-heading" class="section-heading mt-5">See what the engine catches</h2>
        <p class="section-subtitle max-w-[68ch]">Claims about detection depth need traces and results you can inspect.</p>
      </div>

      <div class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-16">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">Five-case comparison</p>
          <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{proof.title}</h3>
          <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{proof.description}</p>
          <a href={proof.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the comparison</a>
        </div>

        <div class="reveal min-w-0 overflow-x-auto border border-border-strong bg-background scrollbar-thin">
          <table class="w-full min-w-[420px] border-collapse font-mono text-left text-[11px] sm:min-w-[560px] sm:text-xs">
            <caption class="sr-only">XSS detection depth by tool and analysis mode across five Java test cases</caption>
            <thead>
              <tr class="text-muted-foreground">
                <th scope="col" rowspan="2" class="px-3 py-3 align-bottom font-medium sm:px-4">Analysis depth</th>
                <th scope="colgroup" colspan="2" class="border-l border-border px-3 py-2.5 text-center font-medium sm:px-4">Semgrep Code</th>
                <th scope="colgroup" class="border-l border-border px-3 py-2.5 text-center font-medium sm:px-4">CodeQL</th>
                <th scope="colgroup" colspan="2" class="border-l border-border bg-primary/5 px-3 py-2.5 text-center font-semibold text-primary sm:px-4">OpenTaint</th>
              </tr>
              <tr class="border-b border-border-strong text-muted-foreground">
                {coverageColumns.map((column) => (
                  <th scope="col" class:list={[
                    "border-l border-border px-3 py-2.5 text-center text-[11px] font-normal sm:px-4",
                    column.accent && "bg-primary/5",
                  ]}>{column.mode}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {coverageRows.map((row, rowIndex) => (
                <tr class="matrix-row border-b border-border transition-colors duration-200 last:border-b-0 hover:bg-primary/[0.04] motion-reduce:transition-none" style={`--row-index:${rowIndex}`}>
                  <th scope="row" class="px-3 py-3 font-medium text-foreground sm:px-4">{row.depth}</th>
                  {row.cells.map((state, index) => (
                    <td class:list={[
                      "border-l border-border px-3 py-3 text-center sm:px-4",
                      coverageColumns[index].accent ? "bg-primary/5 text-primary" : "text-foreground",
                    ]}>
                      <span class="sr-only">{coverageStates[state].label}</span>
                      <span aria-hidden="true" class:list={[
                        "inline-block h-[11px] w-[11px] border border-current align-middle",
                        state === "miss" && "opacity-40",
                        coverageStates[state].fill,
                      ]}></span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border px-3 py-3 font-mono text-[11px] leading-5 text-muted-foreground sm:px-4">
            {Object.values(coverageStates).map((state) => (
              <span class="flex items-center gap-2">
                <span aria-hidden="true" class:list={["inline-block h-[10px] w-[10px] border border-current", state.fill]}></span>
                {state.label}
              </span>
            ))}
          </p>
        </div>
      </div>

      <div class="reveal mt-14 grid gap-8 border-t border-border pt-14 lg:mt-20 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16 lg:pt-20">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">The agent skills</p>
          <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{skills.title}</h3>
          <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{skills.description}</p>
          <a href={skills.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the release post</a>
        </div>

        <ol class="grid gap-px border border-border-strong bg-border sm:grid-cols-3">
          {skills.steps.map((step, index) => (
            <li class="reveal flex flex-col bg-background p-5 lg:p-6">
              <span class="font-mono text-[11px] font-semibold tracking-[0.14em] text-primary">0{index + 1}</span>
              <span class="mt-4 font-mono text-[13px] font-semibold leading-5 text-foreground">{step.title}</span>
              <span class="mt-2 font-mono text-[11px] leading-5 text-muted-foreground">{step.detail}</span>
              <code class="mt-4 font-mono text-[11px] text-muted-foreground">{step.skill}</code>
            </li>
          ))}
        </ol>
      </div>

    </div>
  </div>
</section>

<script>
  /* Links the cadence rail to the two panels under it: pointing at (or focusing)
     a stage dims the stages of the other phase and lights the matching panel, so
     "one review, then every commit" reads as one connected idea. Pure
     enhancement — without it, every stage and panel simply stays at rest. */
  const rail = document.querySelector<HTMLElement>("[data-cadence]");
  const panels = [...document.querySelectorAll<HTMLElement>(".economics-panel")];

  if (rail && panels.length) {
    const stages = [...rail.querySelectorAll<HTMLElement>(".cadence-stage")];

    const setPhase = (phase: string | null) => {
      stages.forEach((stage) => {
        stage.dataset.dimmed = String(Boolean(phase) && stage.dataset.phase !== phase);
      });
      panels.forEach((panel) => {
        panel.dataset.active = String(Boolean(phase) && panel.dataset.phase === phase);
      });
    };

    stages.forEach((stage) => {
      const activate = () => setPhase(stage.dataset.phase ?? null);
      const clear = () => setPhase(null);
      stage.addEventListener("pointerenter", activate);
      stage.addEventListener("focus", activate);
      stage.addEventListener("pointerleave", clear);
      stage.addEventListener("blur", clear);
    });
  }
</script>
