---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/astro/SiteHeader.astro";
import LandingFooter from "@/components/astro/LandingFooter.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import { getPostSummaries } from "@/lib/content";
import { siteConfig } from "@/lib/site";
import { getBlogArtwork } from "@/lib/blogArtwork";

const posts = await getPostSummaries();
const title = "OpenTaint Blog | AppSec Guides, Benchmarks, and Case Studies";
const description = "Guides, benchmarks, case studies, and technical research on application security, taint analysis, vulnerability discovery, and CI/CD security checks.";

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "OpenTaint Blog",
  description,
  url: `${siteConfig.url}/blog/`,
  hasPart: posts.map((post) => ({
    "@type": post.contentType === "Case study" ? "BlogPosting" : "TechArticle",
    headline: post.title,
    description: post.description,
    url: `${siteConfig.url}/blog/${post.slug}/`,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${siteConfig.url}/blog/`,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={["application security guides", "taint analysis guide", "sast benchmarks", "vulnerability case studies", "ci cd security checks", "security review workflow"]}
  structuredData={[collectionSchema, breadcrumbSchema]}
>
  <div class="min-h-screen bg-background flex flex-col">
    <SiteHeader />
    <main id="main" class="flex-1 pt-16">
      <div class="page-container">
        <section class="page-section">
          <Breadcrumbs items={[
            { label: "Home", href: "/" },
            { label: "Blog" },
          ]} />
          <h1 class="mt-4 font-mono text-[26px] font-bold tracking-tight text-foreground sm:text-[30px] md:text-[38px] md:leading-[1.15] lg:text-[42px]">Guides, benchmarks, and case studies</h1>
          <p class="section-subtitle max-w-4xl">Learn how to find vulnerabilities with taint analysis, investigate real findings, and enforce verified checks in local development and CI/CD.</p>
        </section>

        <section class="page-section">
          <div class="space-y-0">
            {posts.map((post) => (
              <article class="grid gap-5 border-b border-border py-6 last:border-0 sm:grid-cols-[12rem_1fr] sm:items-start lg:grid-cols-[16rem_1fr] lg:gap-8 lg:py-8">
                {getBlogArtwork(post.slug) && (
                  <a href={`/blog/${post.slug}/`} class="block overflow-hidden rounded-md border border-border bg-secondary" tabindex="-1" aria-hidden="true">
                    <img
                      src={getBlogArtwork(post.slug)!.src}
                      alt=""
                      width="1600"
                      height="1000"
                      class="aspect-[8/5] h-full w-full object-cover transition-transform duration-500 motion-reduce:transition-none hover:scale-[1.025]"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="min-w-0">
                  <h2 class="font-mono text-base font-medium text-foreground lg:text-[17px]">
                    <a href={`/blog/${post.slug}/`} class="transition-colors hover:text-primary">
                      {post.title}
                    </a>
                  </h2>
                  <p class="mt-2 font-mono text-[15px] leading-[175%] text-muted-foreground lg:text-base">{post.description}</p>
                  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] text-muted-foreground sm:text-xs lg:text-[13px]">
                    <span class="font-semibold uppercase tracking-[0.12em] text-primary">{post.contentType}</span>
                    <span>{post.updatedDate ? "Last reviewed" : "Published"} {new Date(post.updatedDate || post.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <LandingFooter />
      </div>
    </main>
  </div>
</BaseLayout>
