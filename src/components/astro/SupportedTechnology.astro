---
const roadmap = [
  { name: "Go", logos: ["/pictures/go-logo.svg"] },
  { name: "Python", logos: ["/pictures/python-logo.svg"] },
  { name: "C#", logos: ["/pictures/csharp-logo.svg"] },
  {
    name: "JavaScript + TypeScript",
    logos: ["/pictures/javascript-logo.svg", "/pictures/typescript-logo.svg"],
  },
];

---

<section class="band technology-band" aria-labelledby="technology-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">Analysis coverage</p>
      <h2 id="technology-heading" class="section-heading">Supported languages and frameworks</h2>
    </div>

    <div class="section-content overflow-hidden rounded-2xl border border-border-strong bg-background shadow-sm lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
      <section class="px-4 py-6 sm:px-8 sm:py-8 lg:border-r lg:border-border" aria-labelledby="technology-available-heading">
        <h3 id="technology-available-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">Available now</h3>

        <div class="mt-6 grid grid-cols-2 items-center gap-6 sm:mt-8 sm:gap-8" role="list" aria-label="Available analysis coverage">
          <div class="flex min-w-0 flex-col items-center gap-4 text-center" role="listitem">
            <span class="flex items-center justify-center" aria-hidden="true">
              <span class="flex h-16 w-16 items-center justify-center rounded-full border border-border bg-white shadow-sm">
                <img src="/pictures/java-logo.svg" alt="" class="h-12 w-12 object-contain" />
              </span>
              <span class="-ml-2 flex h-16 w-16 items-center justify-center rounded-full border border-border bg-white shadow-sm">
                <img src="/pictures/kotlin-logo.svg" alt="" class="h-12 w-12 object-contain" />
              </span>
            </span>
            <span class="font-mono text-sm font-semibold text-foreground">Java + Kotlin</span>
          </div>

          <a href="/blog/spring-analyzer/" class="flex min-w-0 flex-col items-center gap-4 text-center text-foreground transition-colors hover:text-primary" role="listitem">
            <span class="flex h-16 items-center justify-center" aria-hidden="true">
              <img src="/pictures/spring-boot-logo.svg" alt="" class="h-12 w-auto max-w-[10rem]" />
            </span>
            <span class="font-mono text-sm font-semibold">Spring</span>
          </a>
        </div>
      </section>

      <section class="border-t border-border bg-code-bg px-4 py-6 sm:px-8 sm:py-8 lg:border-t-0" aria-labelledby="technology-roadmap-heading">
        <h3 id="technology-roadmap-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">Roadmap</h3>

        <ul class="mt-6 grid grid-cols-2 gap-6 sm:mt-8 sm:grid-cols-4 sm:gap-8" aria-label="Planned language support">
          {roadmap.map((item) => (
            <li class="flex min-w-0 flex-col items-center gap-4 text-center">
              <span class="flex h-16 min-w-16 items-center justify-center" aria-hidden="true">
                {item.logos.map((logo, index) => (
                  <span class:list={[
                    "flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-border bg-white shadow-sm",
                    index > 0 && "-ml-2",
                  ]}>
                    <img src={logo} alt="" class="h-12 w-12 object-contain" />
                  </span>
                ))}
              </span>
              <span class="font-mono text-xs font-semibold leading-5 text-foreground">{item.name}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>
