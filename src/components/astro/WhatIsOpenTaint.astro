---
import { Code } from "astro-expressive-code/components";

const discoveries = [
  { label: "Trust boundary", text: "Unauthenticated workflow input reaches the script evaluators" },
  { label: "Vulnerability pattern", text: "Untrusted text passed to <code>Context.eval()</code> on a context built with <code>allowAllAccess(true)</code>" },
  { label: "Opaque behavior", text: "<code>Builder.option()</code> returns the same builder" },
];

const features = [
  {
    title: "Fast scans, fewer false alarms, fewer missed findings",
    description:
      "Formal inter-procedural dataflow analysis tracks tainted values across procedures, fields, aliases, async code, and persistence layers at scale.",
  },
  {
    title: "Open source, customizable, and self-hosted",
    description:
      "Engine, AST-pattern rules, agent skills, and CI integrations ship under Apache 2.0 and MIT — an AI-ready open source alternative to Semgrep Pro and CodeQL.",
  },
];

/* Both artifacts come from the CVE-2026-58138 reproduction kit. Fully-qualified
   names are shortened to keep the lines readable; everything else is verbatim. */
const artifacts = [
  {
    label: "Taint rule",
    file: ".opentaint/rules/graalvm-polyglot-sinks.yaml",
    caption: "The vulnerability pattern the agent found: attacker-controlled script text evaluated on a context with full host access.",
    code: `id: graalvm-polyglot-eval
languages: [java]
mode: taint
pattern-sinks:
  - patterns:
      - pattern: (Context $CTX).eval($LANG, $SOURCE)
      - focus-metavariable: $SOURCE
      # Only a context with full host access is RCE.
      - pattern-inside: |
          Context $CTX = $B
            .allowAllAccess(true).build();
          ...`,
  },
  {
    label: "Dependency model",
    file: ".opentaint/config/org.graalvm.polyglot.yaml",
    caption: "The library behavior the engine cannot see: a fluent builder that mutates and returns the same instance, so taint survives the chain.",
    code: `language: java
passThrough:
  - function: Context$Builder#option
    copy:
      - from: this
        to: result

  - function: Source$Builder#cached
    copy:
      - from: this
        to: result`,
  },
];

/* The reported flow, source first. `where` says what the value crosses, not
   where it lives — file and line belong in the report, not on a landing page. */
const traceSteps = [
  { role: "Source", label: "HTTP request", where: "Unauthenticated workflow input" },
  { role: "Step", label: "Task scheduling", where: "Across the workflow executor" },
  { role: "Step", label: "Executor lambda", where: "Captured, then run on another thread" },
  { role: "Sink", label: "Context.eval", where: "Evaluated with full host access" },
];
---

<section class="band" aria-labelledby="what-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">What OpenTaint does</p>
      <h2 id="what-heading" class="section-heading mt-5">Taint analysis that turns agent discoveries into deterministic coverage</h2>
      <p class="section-subtitle max-w-[68ch]">
        Agents capture new vulnerability patterns as AST-pattern taint rules, and opaque library behavior as dependency models. The engine applies both on every scan, without burning model tokens again.
      </p>
    </div>


    <figure class="mt-10 overflow-hidden border-y border-border-strong bg-background lg:mt-14" aria-labelledby="workflow-caption">
      <figcaption id="workflow-caption" class="flex flex-col gap-3 border-b border-border px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">One review becomes continuous coverage</span>
        <a href="/blog/conductor-rce-cve-2026-58138" class="font-mono text-xs font-semibold text-foreground underline decoration-primary/30 underline-offset-4 transition-colors hover:text-primary">Real artifacts from CVE-2026-58138</a>
      </figcaption>

      <div class="p-5 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-primary">01</span>
            <span class="text-foreground">Agent discovers</span>
          </p>
          <p class="font-mono text-[11px] leading-5 text-muted-foreground">Model reasoning, on demand</p>
        </div>

        <div class="mt-5 grid md:mt-7 md:grid-cols-3">
          {discoveries.map((item, index) => (
            <div class:list={[
              "reveal py-3 md:py-0",
              index > 0 && "border-t border-border md:border-l md:border-t-0 md:pl-8",
              index < discoveries.length - 1 && "md:pr-8",
            ]}>
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground md:text-[11px]">{item.label}</p>
              <p class="mt-1.5 max-w-[36ch] font-mono text-[13px] font-semibold leading-[1.5] text-foreground md:mt-3 md:text-[15px] md:leading-7" set:html={item.text}></p>
            </div>
          ))}
        </div>
      </div>

      <div class="border-t border-border p-5 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-primary">02</span>
            <span class="text-foreground">Agent writes</span>
          </p>
          <p class="font-mono text-[11px] leading-5 text-muted-foreground">Committed to your repo, versioned, reviewed, and tested like code</p>
        </div>

        <div class="mt-7 grid gap-6 lg:grid-cols-2">
          {artifacts.map((artifact) => (
            <article class="reveal flex min-w-0 flex-col overflow-hidden border border-border-strong transition-colors duration-300 hover:border-primary/60 motion-reduce:transition-none">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border bg-code-header px-4 py-3">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">{artifact.label}</span>
                <span class="font-mono text-[11px] text-muted-foreground">{artifact.file.split("/").pop()}</span>
              </div>
              <Code code={artifact.code} lang="yaml" class="artifact-code" />
              <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-5 text-muted-foreground">{artifact.caption}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="border-t border-border p-5 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-primary">03</span>
            <span class="text-foreground">OpenTaint scans every change</span>
          </p>
          <p class="font-mono text-[11px] leading-5 text-muted-foreground">Deterministic CPU analysis, on every scan</p>
        </div>

        <div class="mt-7 grid items-stretch gap-8 lg:grid-cols-[1.5fr_0.5fr] lg:gap-10">
          {/* Both panels are the same box: header strip, body, footer strip —
              so their borders, tops, and bottoms line up whatever the content
              inside them costs. */}
          <figure class="reveal flex min-w-0 flex-col border border-border-strong">
            <figcaption class="border-b border-border bg-code-header px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">
              Reported finding
            </figcaption>

            <a href="/reports/conductor-cve-2026-58138.html" class="group relative block flex-1 overflow-hidden bg-background">
              <span class="pointer-events-none absolute bottom-0 right-0 z-10 translate-y-full bg-primary px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none">Open the report</span>
              <img src="/pictures/report/trace-light.webp" alt="OpenTaint report with the tainted script flow selected and its steps listed below the source" class="h-full w-full object-cover object-top transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.01] dark:hidden" loading="lazy" width="1600" height="1000" />
              <img src="/pictures/report/trace-dark.webp" alt="OpenTaint report with the tainted script flow selected and its steps listed below the source" class="hidden h-full w-full object-cover object-top transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.01] dark:block" loading="lazy" width="1600" height="1000" />
            </a>

            <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-5 text-muted-foreground">
              Every finding opens to the flow that produced it, step by step.
            </p>
          </figure>

          <div class="reveal flex min-w-0 flex-col border border-border-strong">
            <p class="border-b border-border bg-code-header px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">
              Reported taint trace
            </p>

            <ol class="trace flex-1 px-4 py-5 font-mono">
              {traceSteps.map((step, index) => (
                <li class="trace-step relative pl-7">
                  <span class:list={[
                    "absolute left-0 top-[7px] h-2.5 w-2.5 border",
                    step.role === "Source" || step.role === "Sink" ? "border-primary bg-primary" : "border-border-strong bg-background",
                  ]} aria-hidden="true"></span>
                  {index < traceSteps.length - 1 && (
                    <span class="trace-rail absolute -bottom-5 left-[4.5px] top-[17px] w-px bg-border-strong" aria-hidden="true"></span>
                  )}
                  <span class:list={[
                    "block text-[10px] uppercase tracking-[0.14em]",
                    step.role === "Step" ? "text-muted-foreground" : "text-primary",
                  ]}>{step.role}</span>
                  <span class="mt-1 block text-[13px] font-semibold leading-5 text-foreground">{step.label}</span>
                  <span class="mb-5 mt-1 block text-[11px] leading-5 text-muted-foreground">{step.where}</span>
                </li>
              ))}
            </ol>

            <p class="border-t border-border px-4 py-3 font-mono text-[10px] leading-[1.6] text-muted-foreground">
              182 steps in full, reported on the pull request that introduces the flow.
            </p>
          </div>
        </div>

        <ul class="mt-8 grid gap-x-14 gap-y-8 border-t border-border pt-7 md:grid-cols-2 lg:mt-10">
          {features.map((feature) => (
            <li class="reveal">
              <h3 class="font-mono text-[15px] font-semibold leading-6 text-foreground lg:text-base">{feature.title}</h3>
              <p class="mt-2 max-w-[56ch] font-mono text-sm leading-7 text-muted-foreground">{feature.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </figure>
  </div>
</section>
