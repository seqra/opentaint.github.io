---
import Figure from "./Figure.astro";

// A recorded figure animation (see scripts/sast-is-dead-videos). Each video
// exists in two layouts (wide, tall for phones) and two themes. The posters
// show without JavaScript or with reduced motion; otherwise the script loads
// the matching video and plays it while it is on screen.
type Props = {
  name: string;
  number: number;
  title: string;
  subtitle?: string;
  caption?: string;
  description: string;
  wide: { width: number; height: number };
  tall: { width: number; height: number };
};

const { name, number, title, subtitle, caption, description, wide, tall } = Astro.props;
const base = `/videos/sast-is-dead/${name}`;
const PHONE = "(max-width: 640px)";
---

<Figure number={number} title={title} subtitle={subtitle} caption={caption}>
  <div class="sid-video" data-video={base} data-phone={PHONE} role="img" aria-label={description}>
    {["light", "dark"].map((theme) => (
      <picture class={`sid-video-poster sid-video-${theme}`}>
        <source media={PHONE} srcset={`${base}-tall-${theme}.png`} width={tall.width} height={tall.height} />
        <img src={`${base}-wide-${theme}.png`} width={wide.width} height={wide.height} alt="" loading="lazy" decoding="async" />
      </picture>
    ))}
    <video muted loop playsinline preload="none" hidden aria-hidden="true"></video>
  </div>
</Figure>

<style>
  .sid-video img,
  .sid-video video {
    display: block;
    width: 100%;
    height: auto;
  }
  .sid-video video[hidden],
  .sid-video-dark,
  :global(.dark) .sid-video-light {
    display: none;
  }
  :global(.dark) .sid-video-dark {
    display: block;
  }
  .sid-video[data-playing] .sid-video-poster {
    display: none;
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  const setup = (root: HTMLElement) => {
    const video = root.querySelector("video");
    if (!video) return;
    const phone = window.matchMedia(root.dataset.phone ?? "");
    let visible = false;

    const source = () => {
      const theme = document.documentElement.classList.contains("dark") ? "dark" : "light";
      return `${root.dataset.video}-${phone.matches ? "tall" : "wide"}-${theme}.mp4`;
    };

    const sync = () => {
      if (reduced.matches || !visible) {
        video.pause();
        return;
      }
      const src = source();
      if (!video.src.endsWith(src)) {
        root.removeAttribute("data-playing");
        video.hidden = true;
        video.src = src;
      }
      video.play().catch(() => undefined);
    };

    video.addEventListener("playing", () => {
      video.hidden = false;
      root.setAttribute("data-playing", "");
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }, { threshold: 0.25 }).observe(root);
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    phone.addEventListener("change", sync);
  };

  document.querySelectorAll<HTMLElement>("[data-video]").forEach(setup);
</script>
