---
import { consentCopy } from "@/lib/consent-copy";

const links = [
  { href: "https://github.com/seqra/opentaint", label: "GitHub", external: true },
  { href: "https://discord.gg/6BXDfbP4p9", label: "Discord", external: true },
  { href: "/blog", label: "Blog", external: false },
  { href: "mailto:seqradev@gmail.com", label: "Contact", external: false },
];
---

<footer>
  <div class="footer-links grid grid-cols-2 sm:grid-cols-4">
    {links.map((link) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class="flex min-h-12 items-center justify-center py-4 font-mono text-sm font-medium text-muted-foreground transition-colors hover:text-primary lg:py-6 lg:text-[15px]"
      >
        {link.label}
      </a>
    ))}
  </div>

  <div class="flex flex-col items-center justify-center gap-3 py-6 sm:flex-row sm:gap-6 lg:py-8">
    <span class="font-mono text-xs text-muted-foreground lg:text-[13px]">&copy; 2026 Seqra Team</span>
    <!-- Withdrawing consent has to be as easy as giving it. -->
    <button
      type="button"
      id="consent-settings"
      class="font-mono text-xs text-muted-foreground underline-offset-4 transition-colors hover:text-primary hover:underline lg:text-[13px]"
    >
      {consentCopy.settings}
    </button>
  </div>
</footer>

<script>
  import { requestConsentReopen } from "@/lib/consent-runtime";

  document
    .getElementById("consent-settings")
    ?.addEventListener("click", () => requestConsentReopen());
</script>

<style>
  /* Divider styling is shared globally via `.footer-links` in index.css. */
  .footer-links {
    position: relative;
  }
</style>
