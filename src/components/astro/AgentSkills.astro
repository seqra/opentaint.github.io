---
import AgentPipeline from "@/components/astro/AgentPipeline.astro";

const skills = {
  href: "/blog/appsec-agent",
  description:
    "The appsec-agent skill builds the project, runs OpenTaint, discovers the attack surface, adds targeted taint rules, models opaque library code, triages findings, and optionally generates dynamic proof-of-concept checks for confirmed vulnerabilities.",
};
---

<section class="band" aria-labelledby="agent-skills-heading">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">The agent skills</p>
      <h2 id="agent-skills-heading" class="section-heading mt-6">An end-to-end application-security workflow</h2>
    </div>

    <div class="mt-10 grid gap-8 lg:mt-16 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-12">
      <div class="lg:order-2">
        <h3 class="font-mono text-xl font-semibold leading-8 text-foreground">Fifteen composable skills, one workflow</h3>
        <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{skills.description}</p>
        <a href={skills.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the release post</a>
      </div>

      <AgentPipeline />
    </div>
  </div>
</section>
