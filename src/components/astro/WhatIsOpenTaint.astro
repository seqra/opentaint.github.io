---
import { Code } from "astro-expressive-code/components";
import PerlinBackdrop from "@/components/astro/PerlinBackdrop.astro";

/* Both artifacts come from the CVE-2026-58138 reproduction kit. Fully-qualified
   names are shortened to keep the lines readable; everything else is verbatim. */
const artifacts = [
  {
    label: "Taint rule",
    file: ".opentaint/rules/graalvm-polyglot-sinks.yaml",
    caption: "Fires only when the context was built with full host access.",
    code: `id: graalvm-polyglot-eval
languages: [java]
mode: taint
pattern-sinks:
  - patterns:
      - pattern: (Context $CTX).eval($LANG, $SOURCE)
      - focus-metavariable: $SOURCE
      # Only a context with full host access is RCE.
      - pattern-inside: |
          Context $CTX = $B
            .allowAllAccess(true).build();
          ...`,
  },
  {
    label: "Dependency model",
    file: ".opentaint/config/org.graalvm.polyglot.yaml",
    caption: "The builder mutates and returns itself, so taint survives the chain.",
    code: `language: java
passThrough:
  - function: Context$Builder#option
    copy:
      - from: this
        to: result

  - function: Source$Builder#cached
    copy:
      - from: this
        to: result`,
  },
];

/* The reported flow, source first. `where` says what the value crosses, not
   where it lives — file and line belong in the report, not on a landing page. */
const traceSteps = [
  { role: "Source", label: "HTTP request", where: "Unauthenticated workflow input" },
  { role: "Step", label: "Task scheduling", where: "Across the workflow executor" },
  { role: "Step", label: "Executor lambda", where: "Captured, then run on another thread" },
  { role: "Sink", label: "Context.eval", where: "Evaluated with full host access" },
];
---

<section class="band real-world-band" aria-labelledby="what-heading">
  <PerlinBackdrop class="section-flow-noise-soft" />
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">A real-world review</p>
      <h2 id="what-heading" class="section-heading">How OpenTaint found CVE-2026-58138</h2>
      <a href="/blog/conductor-rce-cve-2026-58138" class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the CVE-2026-58138 reproduction post.</a>
    </div>


    <figure class="section-content overflow-hidden rounded-xl border border-border-strong bg-background" aria-labelledby="what-heading">
      <div class="p-6 sm:p-6 lg:p-8">
        <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
          <span class="text-primary">01</span>
          <span class="text-foreground">Agent reviews</span>
        </p>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <article class="reveal min-w-0 overflow-hidden rounded-xl border border-border-strong bg-code-bg">
            <div class="flex items-center justify-between border-b border-border bg-code-header px-4 py-3 font-mono text-[10px] text-muted-foreground">
              <span class="font-semibold text-foreground">WorkflowResource.java / Lambda.java</span>
              <span class="uppercase tracking-[0.12em]">request path</span>
            </div>
            <pre class="overflow-x-auto px-4 py-6 font-mono text-[10px] leading-6 text-foreground sm:px-6 sm:text-[11px]"><code><span class="text-muted-foreground">77</span>  @PostMapping(produces = TEXT_PLAIN_VALUE)
<span class="text-muted-foreground">81</span>  public String startWorkflow(
<span class="text-muted-foreground">82</span>      @RequestBody StartWorkflowRequest request) &#123;
<span class="text-muted-foreground">83</span>    return workflowService.startWorkflow(request);
<span class="text-muted-foreground">84</span>  &#125;

<span class="text-emerald-700 dark:text-emerald-400">// Trust boundary: request data controls the script.</span>
<span class="text-muted-foreground">68</span>  Map&lt;String, Object&gt; taskInput = task.getInputData();
<span class="text-muted-foreground">71</span>  scriptExpression = (String) taskInput.get(
<span class="text-muted-foreground">72</span>      <span class="text-primary">"scriptExpression"</span>);
<span class="text-muted-foreground">80</span>  Object result = ScriptEvaluator.eval(
<span class="text-muted-foreground">81</span>      scriptExpression, taskInput);</code></pre>
          </article>

          <article class="reveal min-w-0 overflow-hidden rounded-xl border border-border-strong bg-code-bg">
            <div class="flex items-center justify-between border-b border-border bg-code-header px-4 py-3 font-mono text-[10px] text-muted-foreground">
              <span class="font-semibold text-foreground">ScriptEvaluator.java</span>
              <span class="uppercase tracking-[0.12em]">evaluation path</span>
            </div>
            <pre class="overflow-x-auto px-4 py-6 font-mono text-[10px] leading-6 text-foreground sm:px-6 sm:text-[11px]"><code><span class="text-emerald-700 dark:text-emerald-400">// Opaque external method behavior:</span>
<span class="text-emerald-700 dark:text-emerald-400">// option() returns this builder.</span>
<span class="text-muted-foreground">116</span> private static Context createNewContext() &#123;
<span class="text-muted-foreground">117</span>   return Context.newBuilder(<span class="text-primary">"js"</span>)
<span class="text-muted-foreground">118</span>     .<span class="text-primary">allowHostAccess(HostAccess.ALL)</span>
<span class="text-muted-foreground">119</span>     .option("engine.WarnInterpreterOnly", "false")
<span class="text-muted-foreground">120</span>     .build();
<span class="text-muted-foreground">121</span> &#125;

<span class="text-muted-foreground">201</span> <span class="text-emerald-700 dark:text-emerald-400">// Vulnerability pattern:</span>
    <span class="text-emerald-700 dark:text-emerald-400">// untrusted script reaches a host-enabled evaluator.</span>
<span class="text-muted-foreground">202</span> executorService.submit(
<span class="text-muted-foreground">203</span>   () -&gt; context.<span class="text-primary">eval("js", script)</span>);</code></pre>
          </article>
        </div>
      </div>

      <div class="border-t border-border p-6 sm:p-6 lg:p-8">
        <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
          <span class="text-primary">02</span>
          <span class="text-foreground">Agent enacts</span>
        </p>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          {artifacts.map((artifact) => (
            <article class="reveal flex min-w-0 flex-col overflow-hidden rounded-xl border border-border-strong transition-colors duration-300 hover:border-primary/60 motion-reduce:transition-none">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border bg-code-header px-4 py-3">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">{artifact.label}</span>
                <span class="font-mono text-[11px] text-muted-foreground">{artifact.file.split("/").pop()}</span>
              </div>
              <Code code={artifact.code} lang="yaml" class="artifact-code" />
              <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-5 text-muted-foreground">{artifact.caption}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="border-t border-border p-6 sm:p-6 lg:p-8">
        <p class="flex items-baseline gap-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]">
          <span class="text-primary">03</span>
          <span class="text-foreground">Formal taint analysis searches</span>
        </p>

        <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-[1.5fr_0.5fr] lg:gap-10">
          {/* Both panels are the same box: header strip, body, footer strip —
              so their borders, tops, and bottoms line up whatever the content
              inside them costs. */}
          <figure class="reveal flex min-w-0 flex-col overflow-hidden rounded-xl border border-border-strong">
            <figcaption class="border-b border-border bg-code-header px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">
              Reported finding
            </figcaption>

            <a href="/reports/conductor-cve-2026-58138.html" class="group relative block flex-1 overflow-hidden bg-background">
              <span class="pointer-events-none absolute bottom-0 right-0 z-10 translate-y-full bg-primary px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none">Open the report</span>
              <picture>
                <source media="(max-width: 639px)" srcset="/pictures/report/trace-zoom-mobile-light.png" />
                <img src="/pictures/report/trace-zoom-light.png" alt="OpenTaint report zoomed into the vulnerable Context.eval call and the final steps of its 182-step taint trace" class="h-full min-h-[24rem] w-full object-cover object-center transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.015] dark:hidden" loading="lazy" width="2000" height="1340" />
              </picture>
              <picture class="hidden dark:block">
                <source media="(max-width: 639px)" srcset="/pictures/report/trace-zoom-mobile-dark.png" />
                <img src="/pictures/report/trace-zoom-dark.png" alt="OpenTaint report zoomed into the vulnerable Context.eval call and the final steps of its 182-step taint trace" class="h-full min-h-[24rem] w-full object-cover object-center transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.015]" loading="lazy" width="2000" height="1340" />
              </picture>
            </a>

            <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-5 text-muted-foreground">
              Every finding opens to the flow that produced it.
            </p>
          </figure>

          <div class="reveal flex min-w-0 flex-col overflow-hidden rounded-xl border border-border-strong">
            <p class="border-b border-border bg-code-header px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-foreground">
              Reported taint trace
            </p>

            <ol class="trace flex-1 px-4 py-6 font-mono">
              {traceSteps.map((step, index) => (
                <li class="trace-step relative pl-8">
                  <span class:list={[
                    "absolute left-0 top-[7px] h-2.5 w-2.5 border",
                    step.role === "Source" || step.role === "Sink" ? "border-primary bg-primary" : "border-border-strong bg-background",
                  ]} aria-hidden="true"></span>
                  {index < traceSteps.length - 1 && (
                    <span class="trace-rail absolute -bottom-6 left-[4.5px] top-[17px] w-px bg-border-strong" aria-hidden="true"></span>
                  )}
                  <span class:list={[
                    "block text-[10px] uppercase tracking-[0.14em]",
                    step.role === "Step" ? "text-muted-foreground" : "text-primary",
                  ]}>{step.role}</span>
                  <span class="mt-1 block text-[13px] font-semibold leading-5 text-foreground">{step.label}</span>
                  <span class="mb-6 mt-1 block text-[11px] leading-5 text-muted-foreground">{step.where}</span>
                </li>
              ))}
            </ol>

            <p class="border-t border-border px-4 py-3 font-mono text-[10px] leading-[1.6] text-muted-foreground">
              The complete trace spans 182 steps across the codebase.
            </p>
          </div>
        </div>

      </div>
    </figure>

  </div>
</section>
