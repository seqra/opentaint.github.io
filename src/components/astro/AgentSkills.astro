---
import AgentPipeline from "@/components/astro/AgentPipeline.astro";

const skills = {
  href: "/blog/appsec-agent",
  description:
    "AppSec Agent builds and scans, writes rules and models, triages findings, and generates proof-of-concept checks.",
};
---

<section class="band agent-skills-band" aria-labelledby="agent-skills-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">The agent skills</p>
      <h2 id="agent-skills-heading" class="section-heading">An application-security workflow</h2>
    </div>

    <div class="section-content grid gap-6 sm:gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-12">
      <div class="lg:order-2">
        <h3 class="font-mono text-xl font-semibold leading-8 text-foreground">Fifteen composable skills, one workflow</h3>
        <p class="mt-4 max-w-[52ch] font-mono text-sm leading-6 text-muted-foreground sm:leading-7 lg:text-[15px]">{skills.description}</p>
        <a href={skills.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the release post</a>
      </div>

      <AgentPipeline />
    </div>
  </div>
</section>
