---
import AgentPipeline from "@/components/astro/AgentPipeline.astro";

const skills = {
  href: "/blog/appsec-agent",
  title: "An end-to-end application-security workflow",
  description:
    "The appsec-agent skill builds the project, runs OpenTaint, discovers the attack surface, adds targeted taint rules, models opaque library code, triages findings, and optionally generates dynamic proof-of-concept checks for confirmed vulnerabilities.",
};

/* The two halves of the loop. Each stage is the control for its column in the
   table below: it lights that column on wide screens and selects it on narrow
   ones. */
const cadence = [
  {
    phase: "learn",
    label: "One security review",
    detail: "The agent enacts AST-pattern taint rules from vulnerabilities and captures opaque code behavior as dependency models.",
  },
  {
    phase: "search",
    label: "Unlimited security scans",
    detail: "The engine applies those rules and dependency models on every scan without spending model tokens again.",
  },
];

/* One row per question, answered by each phase — shared labels make the two
   columns directly comparable. */
const economics = {
  phases: [
    { key: "learn", name: "Learn" },
    { key: "search", name: "Search" },
  ],
  rows: [
    { label: "Who", learn: "Security agent", search: "Taint analysis engine" },
    { label: "When", learn: "When new context appears", search: "On every change" },
    { label: "Compute", learn: "Model reasoning", search: "Formal inter-procedural dataflow analysis" },
    { label: "Artifacts", learn: "AST-pattern taint rules and dependency models", search: "Detailed dataflow traces" },
  ],
};
---

<section class="band" aria-labelledby="how-heading">
  <div class="mx-auto max-w-6xl">
    <div>
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">The economics</p>
      <h2 id="how-heading" class="section-heading mt-6">Turn what agents learn into reusable search</h2>
    </div>

    <figure class="cadence reveal mt-12 lg:mt-16" data-cadence>
      <figcaption class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">From probabilistic review to versioned artifacts</figcaption>

      <div class="mt-8 grid gap-4 pb-2 sm:grid-cols-2 sm:gap-10">
        {cadence.map((item, index) => (
          <button
            type="button"
            class:list={["cadence-stage rounded-none text-left", index === 1 && "sm:text-right"]}
            data-phase={item.phase}
            aria-pressed="false"
            aria-controls="economics"
          >
            <span class="cadence-label block font-mono text-[15px] font-semibold leading-6 text-foreground">{item.label}</span>
            <span class="mt-2 block w-full text-justify font-mono text-xs leading-5 text-muted-foreground">{item.detail}</span>
          </button>
        ))}
      </div>
    </figure>

    <div class="reveal mt-12 lg:mt-16">
      <div class="overflow-x-auto">
        <table id="economics" class="economics w-full border-collapse font-mono sm:min-w-[560px]" data-economics data-mobile-phase="learn">
          <caption class="sr-only">What each phase costs and what it leaves behind</caption>
          <thead class="hidden sm:table-header-group">
            <tr>
              <th scope="col" class="w-[38%] border-b border-border px-6 pb-4 pt-6 text-right text-lg font-semibold text-foreground lg:text-xl" data-phase="learn">Learn</th>
              <th scope="col" class="w-[24%] border-b border-border px-4 pb-4 pt-6"><span class="sr-only">Attribute</span></th>
              <th scope="col" class="w-[38%] border-b border-border px-6 pb-4 pt-6 text-left text-lg font-semibold text-foreground lg:text-xl" data-phase="search">Search</th>
            </tr>
          </thead>
          <tbody>
            {economics.rows.map((row) => (
              <tr class="economics-row border-t border-border">
                <td class="px-6 py-4 text-right text-xs font-medium text-foreground sm:text-sm" data-phase="learn">{row.learn}</td>
                <th scope="row" class="px-4 py-4 text-center text-xs font-normal uppercase tracking-[0.12em] text-muted-foreground sm:text-[13px]">{row.label}</th>
                <td class="px-6 py-4 text-left text-xs font-medium text-foreground sm:text-sm" data-phase="search">{row.search}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="section-subtitle mx-auto mt-8 max-w-[72ch] text-center">
        The agent learns the attack surface, trust boundaries, vulnerability patterns, and opaque code behavior when new context is needed. The engine applies the resulting taint rules and dependency models on every scan without spending model tokens again.
      </p>
    </div>

  <div class="reveal mt-16 grid gap-8 lg:mt-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-12">
      <div class="lg:order-2">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">The agent skills</p>
        <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{skills.title}</h3>
        <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{skills.description}</p>
        <a href={skills.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the release post</a>
      </div>

      <AgentPipeline />
    </div>

  </div>
</section>

<script>
  /* The two rail stages are the control for the table under them. Wide screens:
     pointing at (or focusing) one lights that phase's column while the rail
     stays a rail. Narrow screens, where three columns of prose do not fit:
     pressing one picks the single column on show. Without JS both stages sit at
     rest and the table shows the Learn column. */
  const rail = document.querySelector<HTMLElement>("[data-cadence]");
  const table = document.querySelector<HTMLElement>("[data-economics]");

  if (rail && table) {
    const stages = [...rail.querySelectorAll<HTMLButtonElement>(".cadence-stage")];
    const narrow = window.matchMedia("(max-width: 639px)");
    let pinnedPhase: string | null = null;

    const highlight = (phase: string | null) => {
      table.dataset.active = phase ?? "";
      stages.forEach((stage) => {
        stage.dataset.dimmed = String(Boolean(phase) && stage.dataset.phase !== phase);
      });
    };

    const select = (phase: string) => {
      table.dataset.mobilePhase = phase;
      stages.forEach((stage) => {
        stage.setAttribute("aria-pressed", String(stage.dataset.phase === phase));
      });
    };

    const pin = (phase: string) => {
      pinnedPhase = pinnedPhase === phase ? null : phase;
      highlight(pinnedPhase);
      stages.forEach((stage) => {
        stage.setAttribute("aria-pressed", String(stage.dataset.phase === pinnedPhase));
      });
    };

    const sync = () => {
      if (narrow.matches) {
        select(table.dataset.mobilePhase ?? "learn");
      } else {
        highlight(pinnedPhase);
        stages.forEach((stage) => {
          stage.setAttribute("aria-pressed", String(stage.dataset.phase === pinnedPhase));
        });
      }
    };

    stages.forEach((stage) => {
      const phase = stage.dataset.phase ?? "learn";
      stage.addEventListener("pointerenter", () => { if (!narrow.matches) highlight(phase); });
      stage.addEventListener("focus", () => { if (!narrow.matches) highlight(phase); });
      stage.addEventListener("pointerleave", () => { if (!narrow.matches) highlight(pinnedPhase); });
      stage.addEventListener("blur", () => { if (!narrow.matches) highlight(pinnedPhase); });
      stage.addEventListener("click", () => {
        if (narrow.matches) select(phase);
        else pin(phase);
      });
    });

    narrow.addEventListener("change", sync);
    sync();
  }
</script>
