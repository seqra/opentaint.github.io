---
import Figure from "./Figure.astro";

// API spend for one property on a linear scale, so the gap shows at its true size.
const MAX = 150_000;
const TICKS = [0, 50_000, 100_000, 150_000];

const rows = [
  { label: "Taint analysis", value: 0, display: "$0", note: "about a minute of CPU", tone: "blue" },
  { label: "AI proof, with prompt caching", value: 11_500, display: "≈ $11,500", note: "", tone: "red" },
  { label: "AI proof, without caching", value: 117_000, display: "≈ $117,000", note: "", tone: "red" },
];

const percent = (value: number) => `${(value / MAX) * 100}%`;
const tick = (value: number) => (value === 0 ? "$0" : `$${value / 1000}K`);
---

<Figure
  number={3}
  title="About a minute of CPU vs. thousands of dollars"
  subtitle="API spend to check one property on a 100K-line Java project"
  caption="The AI figures are estimates at Claude Opus 5.5 API prices; the breakdown is above."
>
  <div class="sid-cost" data-costbars>
    {rows.map((row, i) => (
      <div class="sid-cost-row" style={`--delay: ${i * 0.15}s`}>
        <div class="sid-cost-label">{row.label}</div>
        <div class="sid-cost-track">
          {TICKS.map((value) => <span class="sid-cost-grid" style={`left: ${percent(value)}`}></span>)}
          <div class="sid-cost-mark">
            {row.value === 0
              ? <span class="sid-cost-dot" style={`background: var(--sid-${row.tone})`}></span>
              : <span class="sid-cost-bar" style={`width: ${percent(row.value)}; background: var(--sid-${row.tone})`}></span>}
            <span class="sid-cost-value">
              {row.display}{row.note && <span class="sid-cost-note"> · {row.note}</span>}
            </span>
          </div>
        </div>
      </div>
    ))}
    <div class="sid-cost-row" aria-hidden="true">
      <div></div>
      <div class="sid-cost-axis">
        {TICKS.map((value) => <span style={`left: ${percent(value)}`}>{tick(value)}</span>)}
      </div>
    </div>
  </div>
</Figure>

<style>
  .sid-cost-row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
  }
  .sid-cost-label {
    font-size: 0.9375rem;
    color: hsl(var(--foreground));
  }
  .sid-cost-track {
    position: relative;
    padding: 0.875rem 0;
  }
  .sid-cost-grid {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: hsl(var(--border));
  }
  .sid-cost-mark {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .sid-cost-bar {
    display: block;
    height: 28px;
    border-radius: 0 6px 6px 0;
    transform-origin: left;
    transition: transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay);
  }
  .sid-cost-dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
  }
  .sid-cost-value {
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    color: hsl(var(--foreground));
    transition: opacity 0.5s calc(var(--delay) + 0.6s);
  }
  .sid-cost-note {
    font-weight: 400;
    color: hsl(var(--muted-foreground));
  }
  .sid-cost-axis {
    position: relative;
    height: 1.5rem;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }
  .sid-cost-axis span {
    position: absolute;
    transform: translateX(-50%);
  }
  .sid-cost-axis span:first-child {
    transform: none;
  }
  .sid-cost-axis span:last-child {
    transform: translateX(-100%);
  }
  [data-costbars][data-armed]:not([data-shown]) .sid-cost-bar {
    transform: scaleX(0);
  }
  [data-costbars][data-armed]:not([data-shown]) .sid-cost-value {
    opacity: 0;
  }
  @media (max-width: 640px) {
    .sid-cost-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .sid-cost-row + .sid-cost-row {
      margin-top: 0.75rem;
    }
    .sid-cost-track {
      padding: 0.25rem 0;
    }
  }
</style>

<script>
  // Bars grow from zero the first time the chart scrolls into view.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-costbars]").forEach((chart) => {
      chart.setAttribute("data-armed", "");
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        chart.setAttribute("data-shown", "");
        observer.disconnect();
      }, { threshold: 0.5 });
      observer.observe(chart);
    });
  }
</script>
