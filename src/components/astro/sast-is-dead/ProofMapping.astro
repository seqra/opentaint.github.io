---
import Figure from "./Figure.astro";

// One component diagram drawn twice, side by side on a shared row grid, so
// each part of a proof sits level with its taint analysis counterpart. A bus
// collects the three inputs into the engine, which produces the verdict. The
// lanes differ only in the third component: written and proven by AI on one
// side, approximated by the analyzer on the other.
const lanes = [
  {
    side: "proof",
    name: "Formal proof",
    parts: [
      { term: "Specification", text: "The security property, in the prover's logic" },
      { term: "Environment model", text: "Formal models of the JVM and the libraries" },
      { term: "Program semantics", text: "Written and proven by AI", cost: "≈ $11,500 in tokens" },
    ],
    engine: "Proof checker",
    verdict: "The property holds",
  },
  {
    side: "taint",
    name: "Taint analysis",
    parts: [
      { term: "Rules", text: "Which sources must never reach which sinks" },
      { term: "Library models", text: "How external code moves data" },
      { term: "Dataflow summaries", text: "Approximated by the analyzer", cost: "≈ 1 min of CPU" },
    ],
    engine: "Fixpoint solver",
    verdict: "No such flow exists",
  },
];

// What each row holds, named once on the spine between the lanes.
const roles = [
  { name: "Inputs", rows: "2 / 4" },
  { name: "Computed", rows: "4" },
  { name: "Engine", rows: "5" },
  { name: "Verdict", rows: "6" },
];
---

<Figure
  number={4}
  title="Taint analysis is a lightweight prover"
  subtitle="Both need the same three things. The third costs a proof thousands of dollars, and the analyzer computes it in a minute."
  caption="The first two are inputs, written by people or by an AI agent. The third is computed, and that is where the cost of a proof goes."
>
  <div class="sid-arch">
    {lanes.map((lane) => (
      <>
        <div class="sid-arch-head" data-side={lane.side} style="grid-row: 1">{lane.name}</div>
        {lane.parts.map((part, i) => (
          <div class="sid-arch-box" data-side={lane.side} data-tone={part.cost ? "computed" : "input"} style={`grid-row: ${i + 2}`}>
            <div class="sid-arch-term">{part.term}</div>
            <div class="sid-arch-text">{part.text}</div>
            {part.cost && <div class="sid-arch-cost">{part.cost}</div>}
          </div>
        ))}
        <div class="sid-arch-box sid-arch-engine" data-side={lane.side} style="grid-row: 5">
          <div class="sid-arch-term">{lane.engine}</div>
        </div>
        <div class="sid-arch-verdict" data-side={lane.side} style="grid-row: 6">
          <span class="sid-arch-pill">
            <span class="sid-arch-check" aria-hidden="true">✓</span>
            {lane.verdict}
          </span>
        </div>
      </>
    ))}
    {roles.map((role) => (
      <div class="sid-arch-role" style={`grid-row: ${role.rows}`} aria-hidden="true">{role.name}</div>
    ))}
  </div>
</Figure>

<style>
  .sid-arch {
    /* The bus runs down the left of each lane; every box leaves room for it. */
    --bus: 1.75rem;
    /* Where a stub meets a box: the center of its first line. */
    --tap: 1.5rem;
    --gap: 1.25rem;
    --line: 2px;
    --border: 1.5px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: var(--gap);
    max-width: 46rem;
    margin: 0 auto;
  }
  [data-side="proof"] {
    --lane: var(--sid-red);
    grid-column: 1;
  }
  [data-side="taint"] {
    --lane: var(--sid-blue);
    grid-column: 3;
  }
  .sid-arch-head,
  .sid-arch-box,
  .sid-arch-verdict {
    margin-left: var(--bus);
  }
  .sid-arch-head {
    align-self: end;
    margin-bottom: -0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    color: hsl(var(--foreground));
  }
  .sid-arch-role {
    grid-column: 2;
    align-self: center;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: hsl(var(--muted-foreground));
  }
  .sid-arch-box {
    position: relative;
    padding: 0.75rem 0.875rem;
    border: var(--border) solid hsl(var(--border-strong));
    border-radius: 10px;
    background: hsl(var(--card));
  }
  .sid-arch-box[data-tone="computed"] {
    border-color: var(--lane);
    background: color-mix(in srgb, var(--lane) 9%, hsl(var(--card)));
  }
  .sid-arch-engine {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
  }
  .sid-arch-engine .sid-arch-term {
    color: hsl(var(--background));
  }
  .sid-arch-term {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
    color: hsl(var(--foreground));
  }
  .sid-arch-text {
    margin-top: 0.125rem;
    font-size: 0.9375rem;
    line-height: 1.5rem;
    text-wrap: pretty;
    color: hsl(var(--muted-foreground));
  }
  .sid-arch-cost {
    margin-top: 0.375rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5rem;
    color: hsl(var(--foreground));
  }
  /* Pseudo-elements are placed from the padding box, inside the border, so
     every offset below that crosses a box edge adds the border widths. */
  /* Stub from the bus into the box, at the tap. */
  .sid-arch-box::before {
    content: "";
    position: absolute;
    top: calc(var(--tap) - var(--line) / 2);
    right: 100%;
    width: calc(1rem + var(--border));
    height: var(--line);
    background: var(--lane);
  }
  /* The bus itself: from this tap down to the next box's tap, across this
     box's bottom border, the gap, and the next box's top border. */
  .sid-arch-box::after {
    content: "";
    position: absolute;
    top: calc(var(--tap) - var(--line) / 2);
    bottom: calc(-1 * (var(--gap) + var(--tap) + 2 * var(--border)) - var(--line) / 2);
    right: calc(100% + var(--border) + 1rem - var(--line));
    width: var(--line);
    background: var(--lane);
  }
  /* The engine ends the bus with an arrowhead instead of a stub. */
  .sid-arch-engine::before {
    right: calc(100% + var(--border) + 0.25rem);
    width: 0.75rem;
  }
  .sid-arch-engine::after {
    top: calc(var(--tap) - 0.3125rem);
    bottom: auto;
    right: calc(100% + var(--border));
    width: 0;
    height: 0;
    border: 0.3125rem solid transparent;
    border-right: 0;
    border-left: 0.5rem solid var(--lane);
    background: none;
  }
  /* The verdict hangs under the engine on its own arrow. */
  .sid-arch-verdict {
    position: relative;
    text-align: center;
  }
  .sid-arch-verdict::before {
    content: "";
    position: absolute;
    top: calc(-1 * var(--gap) - var(--border));
    left: calc(50% - var(--line) / 2);
    width: var(--line);
    height: calc(var(--gap) + var(--border) - 0.375rem);
    background: var(--lane);
  }
  .sid-arch-verdict::after {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: calc(50% - 0.3125rem);
    width: 0;
    height: 0;
    border: 0.3125rem solid transparent;
    border-bottom: 0;
    border-top: 0.5rem solid var(--lane);
  }
  .sid-arch-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem 0.375rem 0.5rem;
    border: 1.5px solid var(--sid-good);
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
    color: hsl(var(--foreground));
    background: hsl(var(--card));
  }
  .sid-arch-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    color: hsl(var(--muted));
    background: var(--sid-good);
  }
  /* Phones: the lanes stack, one full pipeline after the other, and the
     spine's row names go; the caption carries them. */
  @media (max-width: 640px) {
    .sid-arch {
      grid-template-columns: minmax(0, 1fr);
    }
    [data-side="proof"],
    [data-side="taint"] {
      grid-column: 1;
      grid-row: auto !important;
    }
    .sid-arch-head[data-side="taint"] {
      margin-top: 1.5rem;
    }
    .sid-arch-role {
      display: none;
    }
  }
</style>
