---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/astro/SiteHeader.astro";
import LandingFooter from "@/components/astro/LandingFooter.astro";
import { createHeroFlowField } from "@/lib/heroFlowField";
import { AnimatedHero } from "@/components/AnimatedHero";
import { FirstScanFunnel } from "@/components/FirstScanFunnel";
import Demo from "@/components/astro/Demo.astro";
import TheEconomics from "@/components/astro/TheEconomics.astro";
import SecurityDebt from "@/components/astro/SecurityDebt.astro";
import WhatIsOpenTaint from "@/components/astro/WhatIsOpenTaint.astro";
import EngineProof from "@/components/astro/EngineProof.astro";
import AgentSkills from "@/components/astro/AgentSkills.astro";
import SupportedTechnology from "@/components/astro/SupportedTechnology.astro";
import FAQ from "@/components/astro/FAQ.astro";
import { defaultKeywords, siteConfig } from "@/lib/site";
import { faqItems } from "@/lib/faq";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.title,
    alternateName: ["opentaint", "opentaint.org"],
    url: siteConfig.url,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.title,
    url: siteConfig.url,
    logo: `${siteConfig.url}/logo.png`,
    sameAs: [
      siteConfig.github,
      siteConfig.discord,
      "https://x.com/seqradev",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.title,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows",
    description: siteConfig.description,
    url: siteConfig.url,
    downloadUrl: "https://github.com/seqra/opentaint/releases",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    author: {
      "@type": "Organization",
      name: siteConfig.author,
      url: siteConfig.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems
      .filter((item) => !item.isContact && item.answer)
      .map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
  },
];
const heroWorkflowFlowLines = createHeroFlowField({ height: 1440 });
const heroWorkflowBasePath = heroWorkflowFlowLines.map((line) => line.d).join(" ");
const heroWorkflowActivePaths = Array.from({ length: 3 }, (_, phase) => heroWorkflowFlowLines
  .filter((line, index) => line.active && index % 3 === phase)
  .map((line) => line.d)
  .join(" "));
---

<BaseLayout
  title="OpenTaint | The Open Source Taint Analysis Engine for the AI Era"
  description={siteConfig.description}
  imageAlt={`OpenTaint — ${siteConfig.tagline}. ${siteConfig.ogTagline}.`}
  keywords={defaultKeywords}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background flex flex-col">
    <SiteHeader />
    <main id="main" class="landing-sections flex-1 pt-16">
      <div class="hero-workflow-group">
        <svg class="hero-workflow-signal-field" viewBox="0 0 1200 1440" preserveAspectRatio="none" aria-hidden="true">
          <g class="hero-signal-graph">
            <path class="hero-signal-base" d={heroWorkflowBasePath}></path>
            {heroWorkflowActivePaths.map((path, phase) => (
              <path class:list={["hero-signal-active", `hero-signal-active-${phase}`]} d={path}></path>
            ))}
          </g>
        </svg>

        <section class="band hero-band">
          <AnimatedHero />
        </section>

        <TheEconomics />
      </div>

      <Demo />

      <FirstScanFunnel client:visible />

      <SecurityDebt />

      <WhatIsOpenTaint />

      <EngineProof />

      <AgentSkills />

      <SupportedTechnology />

      <FAQ />

      <div class="frame-x">
        <LandingFooter />
      </div>
    </main>
  </div>
</BaseLayout>
