---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/astro/SiteHeader.astro";
import LandingFooter from "@/components/astro/LandingFooter.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";

const title = "Privacy Policy";
const description = "How OpenTaint uses website analytics.";
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-screen flex-col bg-background">
    <SiteHeader />
    <main id="main" class="flex-1 pt-16">
      <div class="page-container">
        <section class="page-section">
          <Breadcrumbs items={[
            { label: "Home", href: "/" },
            { label: "Privacy Policy" },
          ]} />

          <div class="mx-auto mt-6 max-w-3xl">
            <h1 class="font-mono text-3xl font-bold tracking-[-0.035em] text-foreground sm:text-4xl">Privacy Policy</h1>
            <p class="mt-3 font-mono text-xs text-muted-foreground">Last updated September 14, 2026</p>

            <div class="privacy-prose mt-8 text-base leading-[175%] text-foreground/85 sm:text-[17px]">
              <p>OpenTaint is an open source project by the Seqra Team. This website is <a href="https://github.com/seqra/opentaint.github.io" target="_blank" rel="noopener noreferrer">open source</a> and hosted on GitHub Pages.</p>
              <p>We use Google Analytics to understand visits and improve this website. It may collect page activity, approximate location, browser and device information, and random identifiers through Analytics cookies.</p>
              <p>Analytics is enabled by default. You can disable or enable it at any time through <strong>Cookie Settings</strong> in the footer. We store that preference in your browser.</p>
              <p>Google processes the Analytics data. See the <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a> for details.</p>
              <p>For privacy questions, email <a href="mailto:seqradev@gmail.com">seqradev@gmail.com</a>.</p>
            </div>
          </div>
        </section>
        <LandingFooter />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .privacy-prose {
    font-family: var(--font-editorial);
  }

  .privacy-prose :global(p) {
    margin-bottom: var(--spacing-05);
  }

  .privacy-prose :global(a) {
    color: hsl(var(--link));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

</style>
