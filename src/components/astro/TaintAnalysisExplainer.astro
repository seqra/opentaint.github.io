---
const stages = [
  {
    step: "01",
    title: "Source",
    description: "Mark untrusted input such as an HTTP parameter, request body, environment variable, or stored value.",
  },
  {
    step: "02",
    title: "Propagation",
    description: "Track the value through assignments, method calls, fields, framework code, async boundaries, and persistence.",
  },
  {
    step: "03",
    title: "Sink",
    description: "Report a path when the value reaches a dangerous operation without a valid sanitizer or safety check.",
  },
] as const;
---

<section class="band taint-analysis-band" aria-labelledby="taint-analysis-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">Taint analysis, explained</p>
      <h2 id="taint-analysis-heading" class="section-heading">What is taint analysis?</h2>
      <p class="mx-auto mt-6 max-w-4xl font-mono text-sm leading-7 text-muted-foreground sm:text-[15px] lg:text-base">
        <strong class="text-foreground">Taint analysis is a static program-analysis technique that tracks untrusted data from a source to a security-sensitive sink.</strong>
        It follows the value through the program and reports a vulnerability path when no valid sanitizer makes the data safe.
      </p>
    </div>

    <ol class="section-content grid gap-6 lg:grid-cols-3" aria-label="How taint flow analysis works">
      {stages.map((stage) => (
        <li class="reveal rounded-xl border border-border-strong bg-background p-6 sm:p-8">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary">{stage.step}</p>
          <h3 class="mt-4 font-mono text-xl font-semibold text-foreground">{stage.title}</h3>
          <p class="mt-4 font-mono text-sm leading-7 text-muted-foreground">{stage.description}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8 grid overflow-hidden rounded-xl border border-border-strong bg-code-bg lg:mt-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div class="p-6 sm:p-8">
        <h3 class="font-mono text-xl font-semibold text-foreground">Deeper taint flow analysis for real applications</h3>
        <p class="mt-4 font-mono text-sm leading-7 text-muted-foreground sm:text-[15px]">
          Local taint checking loses the trail at method and file boundaries. OpenTaint follows values across methods, fields, framework code, async execution, and persistence so security-review knowledge can become reliable checks in CI/CD.
        </p>
      </div>
      <nav class="flex flex-col justify-center gap-4 border-t border-border p-6 font-mono text-sm lg:border-l lg:border-t-0 lg:p-8" aria-label="Taint analysis resources">
        <a href="/blog/what-is-taint-analysis/" class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the taint analysis guide</a>
        <a href="/blog/semgrep-vs-codeql-vs-opentaint/" class="text-foreground underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary">Compare Semgrep, CodeQL, and OpenTaint</a>
        <a href="/blog/spring-analyzer/" class="text-foreground underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary">See Java and Spring analysis</a>
      </nav>
    </div>
  </div>
</section>
