---
import PerlinBackdrop from "@/components/astro/PerlinBackdrop.astro";

/* The reported flow, source first. `where` says what the value crosses, not
   where it lives — file and line belong in the report, not on a landing page. */
const traceSteps = [
  { role: "Source", label: "HTTP request", where: "Unauthenticated workflow input" },
  { role: "Step", label: "Task scheduling", where: "Across the workflow executor" },
  { role: "Step", label: "Executor lambda", where: "Captured, then run on another thread" },
  { role: "Sink", label: "Context.eval", where: "Evaluated with full host access" },
];
---

<section class="band real-world-band" aria-labelledby="what-heading">
  <PerlinBackdrop class="section-flow-noise-soft" />
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="section-header real-world-header">
      <p class="section-eyebrow">A real-world review</p>
      <h2 id="what-heading" class="section-heading real-world-heading">How OpenTaint found critical CVE-2026-58138</h2>
      <a href="/blog/conductor-rce-cve-2026-58138/" class="mt-6 inline-flex font-mono text-[15px] font-semibold leading-6 text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground lg:text-base">Read the detailed case study</a>
    </div>


    <figure class="section-content overflow-hidden rounded-xl border border-border-strong bg-background p-4 sm:p-6 lg:p-8" aria-labelledby="what-heading">
        <div class="cve-card-rail cve-card-rail-compact mobile-card-rail grid items-stretch gap-6 lg:grid-cols-[1.5fr_0.5fr] lg:gap-10" role="region" aria-label="OpenTaint finding and reported trace" tabindex="0">
          {/* Both panels are the same box: header strip, body, footer strip —
              so their borders, tops, and bottoms line up whatever the content
              inside them costs. */}
          <figure class="reveal mobile-card-rail-item flex min-w-0 flex-col overflow-hidden rounded-xl border border-border-strong">
            <figcaption class="border-b border-border bg-code-header px-4 py-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground sm:text-[13px]">
              Reported finding
            </figcaption>

            <a href="/reports/conductor-cve-2026-58138.html" class="group relative block flex-1 overflow-hidden bg-background">
              <span class="pointer-events-none absolute bottom-0 right-0 z-10 translate-y-full bg-primary px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none">Open the report</span>
              <div class="reported-finding-mobile" role="img" aria-label="OpenTaint report focused on the vulnerable Context.eval call and the final taint-trace steps">
                <span class="reported-finding-crop reported-finding-code"></span>
                <span class="reported-finding-crop reported-finding-trace"></span>
              </div>
              <img src="/pictures/report/trace-zoom-light.png" alt="OpenTaint report zoomed into the vulnerable Context.eval call and the final steps of its 182-step taint trace" class="hidden h-full min-h-[24rem] w-full object-cover object-center transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.015] sm:block dark:sm:hidden" loading="lazy" width="2000" height="1340" />
              <img src="/pictures/report/trace-zoom-dark.png" alt="OpenTaint report zoomed into the vulnerable Context.eval call and the final steps of its 182-step taint trace" class="hidden h-full min-h-[24rem] w-full object-cover object-center transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-[1.015] dark:sm:block" loading="lazy" width="2000" height="1340" />
            </a>

            <p class="border-t border-border px-4 py-3 font-mono text-xs leading-5 text-muted-foreground sm:text-[13px] sm:leading-6">
              Every finding opens to the flow that produced it.
            </p>
          </figure>

          <div class="reveal mobile-card-rail-item flex min-w-0 flex-col overflow-hidden rounded-xl border border-border-strong">
            <p class="border-b border-border bg-code-header px-4 py-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground sm:text-[13px]">
              Reported taint trace
            </p>

            <ol class="trace flex flex-1 flex-col px-4 py-6 font-mono">
              {traceSteps.map((step, index) => (
                <li class="trace-step relative flex-1 pl-8 last:flex-none">
                  <span class:list={[
                    "absolute left-0 top-[7px] h-2.5 w-2.5 border",
                    step.role === "Source" || step.role === "Sink" ? "border-primary bg-primary" : "border-border-strong bg-background",
                  ]} aria-hidden="true"></span>
                  {index < traceSteps.length - 1 && (
                    <span class="trace-rail absolute -bottom-2 left-[4.5px] top-[17px] w-px bg-border-strong" aria-hidden="true"></span>
                  )}
                  <span class:list={[
                    "block text-[11px] uppercase tracking-[0.14em] sm:text-xs",
                    step.role === "Step" ? "text-muted-foreground" : "text-primary",
                  ]}>{step.role}</span>
                  <span class="mt-1 block text-sm font-semibold leading-6 text-foreground sm:text-[15px]">{step.label}</span>
                  <span class="mb-6 mt-1 block text-xs leading-5 text-muted-foreground sm:text-[13px] sm:leading-6">{step.where}</span>
                </li>
              ))}
            </ol>

            <p class="border-t border-border px-4 py-3 font-mono text-[11px] leading-[1.6] text-muted-foreground sm:text-xs">
              The complete trace spans 182 steps across the codebase.
            </p>
          </div>
        </div>
    </figure>

  </div>
</section>
