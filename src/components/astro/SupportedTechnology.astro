---
const roadmap = [
  { name: "Python", logo: "/pictures/python-logo.svg" },
  { name: "Go", logo: "/pictures/go-logo.svg" },
  { name: "C#", logo: "/pictures/csharp-logo.svg" },
  { name: "JavaScript", logo: "/pictures/javascript-logo.svg" },
  { name: "TypeScript", logo: "/pictures/typescript-logo.svg" },
];

const springCoverage = ["MVC", "Data", "WebFlux", "JPA"];
---

<section class="band technology-band" aria-labelledby="technology-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">Analysis coverage</p>
      <h2 id="technology-heading" class="section-heading">Supported languages and frameworks</h2>
    </div>

    <div class="section-content overflow-hidden rounded-xl border border-border-strong bg-background shadow-sm">
      <div class="flex items-center justify-between border-b border-border bg-code-header px-6 py-4 sm:px-8">
        <p class="flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-foreground">
          <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
          Available today
        </p>
        <span class="font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">JVM</span>
      </div>

      <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
        <article class="border-b border-border p-6 sm:p-8 lg:border-b-0 lg:border-r">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">Languages</p>
          <h3 class="mt-3 font-mono text-xl font-semibold text-foreground sm:text-2xl">Java and Kotlin</h3>

          <div class="mt-8 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
            <div class="flex min-h-32 flex-col items-center justify-center gap-4 rounded-xl border border-border bg-code-bg p-4">
              <img src="/pictures/java-logo.svg" alt="" class="h-12 w-12" />
              <span class="font-mono text-xs font-semibold text-foreground">Java</span>
            </div>

            <div class="flex flex-col items-center gap-2" aria-hidden="true">
              <span class="h-px w-6 bg-border-strong"></span>
              <span class="h-2 w-2 rounded-full bg-primary"></span>
              <span class="h-px w-6 bg-border-strong"></span>
            </div>

            <div class="flex min-h-32 flex-col items-center justify-center gap-4 rounded-xl border border-border bg-code-bg p-4">
              <img src="/pictures/kotlin-logo.svg" alt="" class="h-12 w-12" />
              <span class="font-mono text-xs font-semibold text-foreground">Kotlin</span>
            </div>
          </div>

          <p class="mt-6 font-mono text-xs leading-5 text-muted-foreground">Analyzed together at the bytecode level.</p>
        </article>

        <article class="relative overflow-hidden bg-code-bg p-6 sm:p-8">
          <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full border border-primary/10" aria-hidden="true"></div>
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full border border-primary/15" aria-hidden="true"></div>

          <div class="relative">
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">Framework knowledge</p>
            <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <img src="/pictures/spring-boot-logo.svg" alt="Spring Boot" class="h-14 w-auto sm:h-16" />
              </div>
              <span class="w-fit rounded-full border border-primary/40 bg-primary/[0.06] px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-primary">Deep support</span>
            </div>

            <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {springCoverage.map((item) => (
                <li class="rounded-lg border border-border bg-background/80 px-3 py-3 text-center font-mono text-[11px] font-semibold text-foreground">{item}</li>
              ))}
            </ul>

            <a href="/blog/spring-analyzer/" class="mt-8 inline-flex font-mono text-xs font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground sm:text-sm">
              Explore Spring analysis
            </a>
          </div>
        </article>
      </div>

      <div class="grid border-t border-border bg-code-header sm:grid-cols-[10rem_minmax(0,1fr)] sm:items-center">
        <p class="border-b border-border px-6 py-4 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground sm:border-b-0 sm:border-r sm:px-8">Roadmap</p>
        <ul class="flex items-center gap-6 overflow-x-auto px-6 py-4 scrollbar-thin sm:justify-between sm:px-8">
          {roadmap.map((item) => (
            <li class="flex shrink-0 items-center gap-3 opacity-65">
              <img src={item.logo} alt="" class="h-7 w-7 grayscale-[0.35]" />
              <span class="font-mono text-[10px] font-medium text-muted-foreground">{item.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
