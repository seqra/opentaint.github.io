---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/astro/SiteHeader.astro";
import LandingFooter from "@/components/astro/LandingFooter.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import { siteConfig } from "@/lib/site";

const canonicalUrl = `${siteConfig.url}/taint-analysis/`;
const title = "What Is Taint Analysis? Taint Flow & SAST Guide";
const description = "Learn how taint analysis tracks untrusted data from sources to sinks, how taint flow analysis differs by depth, and what to evaluate in a SAST tool.";

const guideFaq = [
  {
    question: "What is taint analysis?",
    answer: "Taint analysis is a static program-analysis technique that tracks untrusted data from sources, through program operations, to security-sensitive sinks. It reports a path when the data reaches a sink without a valid sanitizer.",
  },
  {
    question: "What is a taint flow?",
    answer: "A taint flow is the path an untrusted value takes from a source to a sink. The path can cross variables, methods, objects, framework calls, asynchronous tasks, and storage before it reaches the dangerous operation.",
  },
  {
    question: "What vulnerabilities can taint analysis detect?",
    answer: "Taint analysis is commonly used for SQL injection, command injection, cross-site scripting, server-side request forgery, path traversal, unsafe deserialization, template injection, and other vulnerabilities where untrusted data reaches a dangerous API.",
  },
  {
    question: "Which languages does OpenTaint support?",
    answer: "OpenTaint currently supports Java and Kotlin, with deep analysis for Spring. Python, Go, C#, JavaScript, and TypeScript are on the roadmap and are not yet available.",
  },
] as const;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    about: [
      { "@type": "Thing", name: "Taint analysis" },
      { "@type": "Thing", name: "Static application security testing" },
      { "@type": "Thing", name: "Data-flow analysis" },
    ],
    author: {
      "@type": "Organization",
      name: siteConfig.author,
      url: siteConfig.url,
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.author,
      url: siteConfig.url,
      logo: { "@type": "ImageObject", url: `${siteConfig.url}/logo.png` },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteConfig.url}/` },
      { "@type": "ListItem", position: 2, name: "Taint analysis guide", item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: guideFaq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  keywords={["taint analysis", "what is taint analysis", "taint analysis tools", "taint flow analysis", "taint checking", "java taint analysis", "sast tools"]}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background flex flex-col">
    <SiteHeader />
    <main id="main" class="flex-1 pt-16">
      <div class="page-container">
        <article>
          <header class="page-section">
            <Breadcrumbs items={[
              { label: "Home", href: "/" },
              { label: "Taint analysis guide" },
            ]} />
            <p class="mt-8 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">Taint analysis guide</p>
            <h1 class="mt-6 max-w-5xl font-mono text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl lg:text-5xl lg:leading-[1.1]">What is taint analysis?</h1>
            <p class="section-subtitle max-w-4xl">How taint flow analysis works, why analysis depth matters, and what to look for in a SAST tool.</p>
          </header>

          <div class="page-section blog-prose max-w-4xl font-mono text-[15px] leading-[190%] text-foreground/85 lg:text-base">
            <p class="text-lg leading-8 text-foreground">
              <strong>Taint analysis is a static program-analysis technique that tracks untrusted data from a source to a security-sensitive sink.</strong> The analyzer follows the value through the program. If that value can reach a sink without passing through an appropriate sanitizer or validation step, the analyzer reports the flow for review.
            </p>
            <p>
              “Taint checking,” “taint tracking,” and “taint flow analysis” usually describe this same source-to-sink model. In application security, the goal is to find exploitable data paths rather than merely matching dangerous function names.
            </p>

            <h2 id="how-taint-analysis-works">How taint analysis works</h2>
            <p>A useful taint model defines four kinds of program behavior:</p>
            <ol>
              <li><strong>Sources</strong> introduce untrusted values, such as HTTP parameters, request bodies, headers, environment variables, files, or database values.</li>
              <li><strong>Propagators</strong> move taint through assignments, return values, parameters, object fields, collections, framework APIs, and storage.</li>
              <li><strong>Sanitizers</strong> make a value safe for a specific use, such as parameterizing a SQL query or encoding text for an HTML context.</li>
              <li><strong>Sinks</strong> are security-sensitive operations, such as executing a command, building a query, rendering HTML, evaluating code, or making a network request.</li>
            </ol>
            <p>
              A source-to-sink path is not automatically a vulnerability. The sanitizer must match the sink: HTML encoding does not make a value safe for a shell command, for example. Good taint analysis preserves enough context to distinguish a protected path from an exploitable one.
            </p>

            <h2 id="example">A small taint-flow example</h2>
            <p>
              Consider a Spring controller that reads a request parameter and passes it through a service before using it in a database query. A syntax matcher looking only at the query may see a dangerous API but cannot determine where the string came from. Inter-procedural taint analysis connects the request source, the service call, and the query sink into one trace. If the query uses parameters correctly, a sanitizer model can stop the flow; if it concatenates the request value, the complete path becomes a finding.
            </p>

            <h2 id="analysis-depth">Analysis depth determines what a tool can find</h2>
            <p>
              “Supports taint analysis” can mean very different things. The practical difference between taint analysis tools is how much real application structure they can follow without losing the value.
            </p>
            <div class="table-wrapper">
              <table>
                <thead>
                  <tr><th>Analysis depth</th><th>What it follows</th><th>Typical limit</th></tr>
                </thead>
                <tbody>
                  <tr><td>Pattern matching</td><td>Source and sink in matching syntax</td><td>Loses values after an assignment or helper call</td></tr>
                  <tr><td>Local taint analysis</td><td>Values within one function</td><td>Stops at method boundaries</td></tr>
                  <tr><td>Inter-procedural analysis</td><td>Calls and returns across methods</td><td>May lose object or framework state</td></tr>
                  <tr><td>Field- and context-sensitive analysis</td><td>Objects, fields, call targets, and framework behavior</td><td>Requires a resolved program model</td></tr>
                  <tr><td>Cross-endpoint analysis</td><td>Values written by one request and read by another</td><td>Requires persistence models</td></tr>
                </tbody>
              </table>
            </div>
            <p>
              Deeper SAST is useful when the vulnerability lives in ordinary application structure: helper methods, dependency injection, builders, asynchronous work, or persistence. It also raises the importance of precise rules and library models, because more reach without more context can create false alarms.
            </p>

            <h2 id="java-taint-analysis">Taint analysis for Java, Kotlin, and Spring</h2>
            <p>
              JVM applications need more than source-file matching. Inheritance, generics, virtual dispatch, bytecode dependencies, and Spring dependency injection all affect which code actually runs. OpenTaint analyzes Java and Kotlin build artifacts so it can resolve those relationships and trace values across methods, fields, asynchronous boundaries, and JPA persistence.
            </p>
            <p>
              OpenTaint does not currently support Python, Go, C#, JavaScript, or TypeScript; those languages are on the roadmap. The current engine is designed for Java, Kotlin, and Spring codebases. See the <a href="/blog/spring-analyzer/">Spring taint-analysis walkthrough</a> for concrete cross-class and stored-flow examples.
            </p>

            <h2 id="choosing-a-tool">How to evaluate taint analysis tools</h2>
            <p>Before adopting a tool, test it against code that resembles your application. Check whether it can:</p>
            <ul>
              <li>trace across methods, classes, fields, and the frameworks you use;</li>
              <li>model sanitizers for the correct security context;</li>
              <li>show a complete, reviewable source-to-sink path;</li>
              <li>let your team add or refine sources, sinks, and dependency behavior;</li>
              <li>run on private code with licensing and CI behavior that fit your workflow;</li>
              <li>reproduce the same finding on later scans.</li>
            </ul>
            <p>
              For a worked comparison of analysis depth, read <a href="/blog/semgrep-vs-codeql-vs-opentaint/">Semgrep vs. CodeQL vs. OpenTaint</a>. It tests the same Java XSS flaw as the value moves through progressively harder program structures.
            </p>

            <h2 id="opentaint">How OpenTaint combines agents with formal analysis</h2>
            <p>
              OpenTaint can run its built-in rules without an AI agent. When an agent is used, its job is to review application-specific context and turn what it learns into explicit taint rules and dependency models. The engine then applies those artifacts with deterministic program analysis on every scan. This keeps flexible reasoning in the review stage and repeatable data-flow checking in CI.
            </p>
            <p>
              The core engine is Apache 2.0 licensed, and the CLI, CI integrations, and rules are MIT licensed. Start with the <a href="/#install">five-minute quickstart</a> or inspect the <a href="https://github.com/seqra/opentaint">OpenTaint source on GitHub</a>.
            </p>

            <h2 id="faq">Taint analysis FAQ</h2>
            <dl>
              {guideFaq.map((item) => (
                <div class="border-b border-border py-6 first:pt-0">
                  <dt class="font-semibold text-foreground">{item.question}</dt>
                  <dd class="mt-3 text-muted-foreground">{item.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>

        <LandingFooter />
      </div>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .blog-prose h2 {
    @apply mt-10 mb-4 scroll-mt-24 font-mono text-2xl font-semibold tracking-[-0.02em] text-foreground;
  }
  .blog-prose p {
    @apply mb-4;
  }
  .blog-prose ul,
  .blog-prose ol {
    @apply mb-6 ml-6 space-y-2;
  }
  .blog-prose ul { @apply list-disc; }
  .blog-prose ol { @apply list-decimal; }
  .blog-prose a {
    @apply text-link underline transition-colors hover:text-foreground;
  }
  .blog-prose table {
    @apply w-full min-w-[44rem] border-collapse text-sm;
  }
  .blog-prose th {
    @apply border-b border-border px-3 py-3 text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground;
  }
  .blog-prose td {
    @apply border-b border-border/60 px-3 py-3 align-top;
  }
  .blog-prose .table-wrapper {
    @apply mb-6 overflow-x-auto rounded-lg border border-border;
  }
</style>
