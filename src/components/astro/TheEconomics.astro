---
import AgentPipeline from "@/components/astro/AgentPipeline.astro";

const proof = {
  href: "/blog/semgrep-vs-codeql-vs-opentaint",
  title: "Detection depth, compared",
  description:
    "See Semgrep, CodeQL, and OpenTaint run against five progressively harder Java XSS cases, from direct returns to builders with virtual dispatch.",
};

const skills = {
  href: "/blog/appsec-agent",
  title: "The agent that writes the rules",
  description:
    "Skills that pair an LLM agent with the engine. It maps your attack surface, models the library methods the engine cannot see, writes rules specific to your code, and confirms a finding by exploiting it. The engine takes it from there.",
};

/* Coverage matrix. Columns pair each tool with the analysis mode it was run in,
   so a miss is attributed to a mode rather than hidden behind a slashed pair.
   State is encoded by fill (solid / half / empty), never by color alone. */
const coverageColumns = [
  { tool: "Semgrep Code", mode: "patterns" },
  { tool: "Semgrep Code", mode: "taint rules" },
  { tool: "CodeQL", mode: "taint rules" },
  { tool: "OpenTaint", mode: "patterns", accent: true },
  { tool: "OpenTaint", mode: "taint rules", accent: true },
];

const coverageRows = [
  { depth: "Direct return", cells: ["full", "full", "full", "full", "full"] },
  { depth: "Local dataflow", cells: ["miss", "full", "full", "full", "full"] },
  { depth: "Inter-procedural", cells: ["miss", "full", "full", "full", "full"] },
  { depth: "Field sensitivity", cells: ["miss", "partial", "partial", "full", "full"] },
  { depth: "Virtual dispatch", cells: ["miss", "miss", "partial", "full", "full"] },
];

const coverageStates = {
  full: { label: "Detected", fill: "bg-current" },
  partial: { label: "Partial", fill: "bg-[linear-gradient(to_right,currentColor_50%,transparent_50%)]" },
  miss: { label: "Missed", fill: "bg-transparent" },
};

/* The two halves of the loop. Each stage is the control for its column in the
   table below: it lights that column on wide screens and selects it on narrow
   ones. */
const cadence = [
  {
    phase: "learn",
    label: "One security review",
    detail: "The agent learns the application, then commits taint rules and dependency models.",
  },
  {
    phase: "search",
    label: "Unlimited security scans",
    detail: "Every commit after it, on CPU, with no model in the loop.",
  },
];

/* One row per question, answered by each phase — shared labels make the two
   columns directly comparable. */
const economics = {
  phases: [
    { key: "learn", name: "Learn" },
    { key: "search", name: "Search" },
  ],
  rows: [
    { label: "Who", learn: "Security agent", search: "Taint analysis engine" },
    { label: "When", learn: "When new context appears", search: "On every change" },
    { label: "Compute", learn: "Expensive model reasoning", search: "Deterministic CPU analysis" },
    { label: "Artifacts", learn: "Taint rules and dependency models", search: "Detailed dataflow traces" },
  ],
};
---

<section class="band" aria-labelledby="how-heading">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-5 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">The economics</p>
        <h2 id="how-heading" class="section-heading mt-5">Learn on demand, search on every scan</h2>
      </div>
      <p class="section-subtitle mt-0 max-w-[68ch]">
        Use model reasoning only when the application reveals new security context. Everything already learned becomes deterministic analysis that runs on CPU for every change.
      </p>
    </div>

    <figure class="cadence reveal mt-10 lg:mt-14" data-cadence>
      <figcaption class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">One security review, unlimited security scans</figcaption>

      <div class="cadence-rail mt-7" aria-hidden="true"></div>

      <div class="mt-5 grid gap-4 pb-2 sm:grid-cols-2 sm:gap-10">
        {cadence.map((item, index) => (
          <button
            type="button"
            class:list={["cadence-stage rounded-none text-left", index === 1 && "sm:text-right"]}
            data-phase={item.phase}
            aria-pressed="false"
            aria-controls="economics"
          >
            <span class="cadence-label block font-mono text-[15px] font-semibold leading-6 text-foreground">{item.label}</span>
            <span class:list={["mt-2 block max-w-[42ch] font-mono text-xs leading-5 text-muted-foreground", index === 1 && "sm:ml-auto"]}>{item.detail}</span>
          </button>
        ))}
      </div>
    </figure>

    <div class="reveal mt-12 lg:mt-16">
      <div class="overflow-x-auto">
        <table id="economics" class="economics w-full border-collapse border-b border-border-strong font-mono sm:min-w-[560px] sm:border-t" data-economics data-mobile-phase="learn">
          <caption class="sr-only">What each phase costs and what it leaves behind</caption>
          <thead class="hidden sm:table-header-group">
            <tr>
              <th scope="col" class="w-[38%] border-b border-border px-5 pb-4 pt-5 text-right text-lg font-semibold text-foreground lg:text-xl" data-phase="learn">Learn</th>
              <th scope="col" class="w-[24%] border-b border-border px-4 pb-4 pt-5"><span class="sr-only">Attribute</span></th>
              <th scope="col" class="w-[38%] border-b border-border px-5 pb-4 pt-5 text-left text-lg font-semibold text-foreground lg:text-xl" data-phase="search">Search</th>
            </tr>
          </thead>
          <tbody>
            {economics.rows.map((row) => (
              <tr class="economics-row">
                <td class="px-5 py-3.5 text-right text-xs font-medium text-foreground sm:text-sm" data-phase="learn">{row.learn}</td>
                <th scope="row" class="px-4 py-3.5 text-center text-xs font-normal uppercase tracking-[0.12em] text-muted-foreground sm:text-[13px]">{row.label}</th>
                <td class="px-5 py-3.5 text-left text-xs font-medium text-foreground sm:text-sm" data-phase="search">{row.search}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-16 border-t border-border-strong pt-14 lg:mt-24 lg:pt-20" aria-labelledby="proof-heading">
      {/* The proof block opens on the centre line: its subtitle is one sentence,
          so a centred header reads as a pause between two dense sections. */}
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">Show, don't tell</p>
        <h2 id="proof-heading" class="section-heading mt-5">See what the engine catches</h2>
        <p class="section-subtitle mx-auto max-w-[56ch]">Claims about detection depth need traces and results you can inspect.</p>
      </div>

      <div class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-16">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">Five-case comparison</p>
          <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{proof.title}</h3>
          <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{proof.description}</p>
          <a href={proof.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the comparison</a>
        </div>

        <div class="reveal min-w-0 overflow-x-auto border border-border-strong bg-background scrollbar-thin">
          {/* Five verdict columns fit a 375px screen only if the cells stop
              padding and the labels shorten; past sm both come back. */}
          <table class="w-full table-fixed border-collapse font-mono text-left text-[10px] sm:table-auto sm:min-w-[560px] sm:text-xs">
            <caption class="sr-only">XSS detection depth by tool and analysis mode across five Java test cases</caption>
            <thead>
              <tr class="text-muted-foreground">
                <th scope="col" rowspan="2" class="w-[36%] px-2 py-3 align-bottom font-medium sm:w-auto sm:px-4">Analysis depth</th>
                <th scope="colgroup" colspan="2" class="border-l border-border px-1 py-2.5 text-center font-medium sm:px-4"><span class="sm:hidden">Semgrep</span><span class="hidden sm:inline">Semgrep Code</span></th>
                <th scope="colgroup" class="border-l border-border px-1 py-2.5 text-center font-medium sm:px-4">CodeQL</th>
                <th scope="colgroup" colspan="2" class="border-l border-border bg-primary/5 px-1 py-2.5 text-center font-semibold text-primary sm:px-4">OpenTaint</th>
              </tr>
              <tr class="border-b border-border-strong text-muted-foreground">
                {coverageColumns.map((column) => (
                  <th scope="col" class:list={[
                    "border-l border-border px-1 py-2.5 text-center text-[9px] font-normal sm:px-4 sm:text-[11px]",
                    column.accent && "bg-primary/5",
                  ]}><span class="sm:hidden">{column.mode === "taint rules" ? "taint" : "pattern"}</span><span class="hidden sm:inline">{column.mode}</span></th>
                ))}
              </tr>
            </thead>
            <tbody>
              {coverageRows.map((row, rowIndex) => (
                <tr class="matrix-row border-b border-border transition-colors duration-200 last:border-b-0 hover:bg-primary/[0.04] motion-reduce:transition-none" style={`--row-index:${rowIndex}`}>
                  <th scope="row" class="px-2 py-3 font-medium text-foreground sm:px-4">{row.depth}</th>
                  {row.cells.map((state, index) => (
                    <td class:list={[
                      "border-l border-border px-1 py-3 text-center sm:px-4",
                      coverageColumns[index].accent ? "bg-primary/5 text-primary" : "text-foreground",
                    ]}>
                      <span class="sr-only">{coverageStates[state].label}</span>
                      <span aria-hidden="true" class:list={[
                        "inline-block h-[11px] w-[11px] border border-current align-middle",
                        state === "miss" && "opacity-40",
                        coverageStates[state].fill,
                      ]}></span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border px-2 py-3 font-mono text-[10px] leading-5 text-muted-foreground sm:gap-x-5 sm:px-4 sm:text-[11px]">
            {Object.values(coverageStates).map((state) => (
              <span class="flex items-center gap-2">
                <span aria-hidden="true" class:list={["inline-block h-[10px] w-[10px] border border-current", state.fill]}></span>
                {state.label}
              </span>
            ))}
          </p>
        </div>
      </div>

      <div class="reveal mt-14 grid gap-7 border-t border-border pt-14 lg:mt-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-12 lg:pt-20">
        <div class="lg:order-2">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">The agent skills</p>
          <h3 class="mt-4 font-mono text-xl font-semibold leading-8 text-foreground">{skills.title}</h3>
          <p class="mt-4 max-w-[52ch] font-mono text-sm leading-7 text-muted-foreground lg:text-[15px]">{skills.description}</p>
          <a href={skills.href} class="mt-6 inline-flex font-mono text-sm font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">Read the release post</a>
        </div>

        <AgentPipeline />
      </div>

    </div>
  </div>
</section>

<script>
  /* The two rail stages are the control for the table under them. Wide screens:
     pointing at (or focusing) one lights that phase's column while the rail
     stays a rail. Narrow screens, where three columns of prose do not fit:
     pressing one picks the single column on show. Without JS both stages sit at
     rest and the table shows the Learn column. */
  const rail = document.querySelector<HTMLElement>("[data-cadence]");
  const table = document.querySelector<HTMLElement>("[data-economics]");

  if (rail && table) {
    const stages = [...rail.querySelectorAll<HTMLButtonElement>(".cadence-stage")];
    const narrow = window.matchMedia("(max-width: 639px)");

    const highlight = (phase: string | null) => {
      table.dataset.active = phase ?? "";
      stages.forEach((stage) => {
        stage.dataset.dimmed = String(Boolean(phase) && stage.dataset.phase !== phase);
      });
    };

    const select = (phase: string) => {
      table.dataset.mobilePhase = phase;
      stages.forEach((stage) => {
        stage.setAttribute("aria-pressed", String(stage.dataset.phase === phase));
      });
    };

    const sync = () => {
      if (narrow.matches) {
        select(table.dataset.mobilePhase ?? "learn");
      } else {
        highlight(null);
        stages.forEach((stage) => stage.setAttribute("aria-pressed", "false"));
      }
    };

    stages.forEach((stage) => {
      const phase = stage.dataset.phase ?? "learn";
      stage.addEventListener("pointerenter", () => { if (!narrow.matches) highlight(phase); });
      stage.addEventListener("focus", () => { if (!narrow.matches) highlight(phase); });
      stage.addEventListener("pointerleave", () => { if (!narrow.matches) highlight(null); });
      stage.addEventListener("blur", () => { if (!narrow.matches) highlight(null); });
      stage.addEventListener("click", () => select(phase));
    });

    narrow.addEventListener("change", sync);
    sync();
  }
</script>
