---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "https://github.com/seqra/opentaint/blob/main/docs/README.md", label: "Docs", external: true },
];
---

<header class="fixed top-0 z-50 w-full border-b border-border bg-background/90 backdrop-blur-md">
  <div class="frame-x flex h-16 w-full items-center">
    <div class="flex-1">
      <a href="/" class="flex w-fit items-center" aria-label="OpenTaint home">
        <svg aria-hidden="true" viewBox="0 0 21 23" class="h-8 w-8 overflow-visible text-foreground" fill="none">
          <path fill="currentColor" d="M9.2002 0C10.6403 0 11.9261.2084 13.0576.625 12.6861 1.2689 12.5 2.0338 12.5 2.9199c0 1.375.4475 2.4792 1.3418 3.3125.8943.7916 2.1136 1.1875 3.6582 1.1875.288 0 .5647-.0145.8301-.042.0455.394.0703.8011.0703 1.2217v5.4805c0 1.7598-.387 3.293-1.1602 4.5996-.7466 1.2799-1.8002 2.28-3.1601 3-1.36.6933-2.9867 1.04-4.8799 1.04-1.8666 0-3.4933-.3467-4.8799-1.04-1.36-.72-2.4269-1.72-3.2002-3C.3735 17.3731 0 15.84 0 14.0801V8.6396C0 6.8798.3735 5.36 1.1201 4.0801 1.8935 2.7734 2.9603 1.7734 4.3203 1.0801 5.7069.3601 7.3336 0 9.2002 0Zm0 4.3604c-1.3065 0-2.3334.3593-3.0801 1.0791C5.3735 6.1594 5 7.2265 5 8.6396v5.4405c0 1.3866.3735 2.4535 1.1201 3.2002.7467.7198 1.7736 1.0801 3.0801 1.0801 1.3332 0 2.3601-.3602 3.0801-1.0801.7466-.7466 1.1201-1.8136 1.1201-3.2002V8.6396c-.0001-1.4131-.3735-2.4802-1.1201-3.2001-.72-.7199-1.7469-1.0791-3.0801-1.0791Z" />
          <path fill="#CA2121" d="M17.4201 5.7999c-1.0134 0-1.8134-.2533-2.4-.76-.5867-.5333-.88-1.24-.88-2.12s.2933-1.5733.88-2.08c.5866-.5333 1.3866-.8 2.4-.8 1.0133 0 1.8133.2667 2.4.8.5866.5067.88 1.2.88 2.08s-.2934 1.5867-.88 2.12c-.5867.5067-1.3867.76-2.4.76Z" />
        </svg>
      </a>
    </div>

    <nav class="hidden items-center gap-6 md:flex lg:gap-8" role="navigation" aria-label="Main navigation">
      {navItems.map((item) => <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined} class="font-mono text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-primary lg:text-[15px]">{item.label}</a>)}
    </nav>

    <div class="flex flex-1 items-center justify-end gap-2 sm:gap-3">
      <button type="button" class="theme-button" aria-label="Toggle theme" data-theme-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2.5"></path>
          <path d="M12 19.5V22"></path>
          <path d="M4.93 4.93l1.77 1.77"></path>
          <path d="M17.3 17.3l1.77 1.77"></path>
          <path d="M2 12h2.5"></path>
          <path d="M19.5 12H22"></path>
          <path d="M4.93 19.07l1.77-1.77"></path>
          <path d="M17.3 6.7l1.77-1.77"></path>
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-moon">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>
      <a href="https://discord.gg/6BXDfbP4p9" target="_blank" rel="noopener noreferrer" class="theme-button hidden sm:inline-flex" aria-label="Discord">
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
      </a>
      <a href="https://x.com/seqradev" target="_blank" rel="noopener noreferrer" class="theme-button hidden sm:inline-flex" aria-label="X">
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-[17px] w-[17px]" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="https://github.com/seqra/opentaint" target="_blank" rel="noopener noreferrer" class="theme-button hidden sm:inline-flex" aria-label="GitHub">
        <svg role="img" viewBox="0 0 98 96" xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" fill="currentColor"><path d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/></svg>
      </a>
      <button
        class="theme-button md:hidden"
        type="button"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg data-menu-icon-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg data-menu-icon-close viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden h-5 w-5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="hidden" data-mobile-shell>
    <button
      type="button"
      aria-label="Close mobile menu overlay"
      class="fixed inset-x-0 bottom-0 top-16 z-40 bg-background/60 backdrop-blur-sm md:hidden"
      data-menu-close
    ></button>
    <div class="absolute left-0 right-0 top-full z-50 border-t border-border bg-background md:hidden">
      <nav class="container space-y-3 px-4 py-4" role="navigation" aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined} class="block py-2 font-mono text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-primary">
            {item.label}
          </a>
        ))}
        <a href="https://discord.gg/6BXDfbP4p9" target="_blank" rel="noopener noreferrer" class="block py-2 font-mono text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-primary">
          Discord
        </a>
        <a href="https://x.com/seqradev" target="_blank" rel="noopener noreferrer" class="block py-2 font-mono text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-primary">
          X
        </a>
        <a href="https://github.com/seqra/opentaint" target="_blank" rel="noopener noreferrer" class="block py-2 font-mono text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-primary">
          GitHub
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const shell = document.querySelector("[data-mobile-shell]");
  const openIcon = document.querySelector("[data-menu-icon-open]");
  const closeIcon = document.querySelector("[data-menu-icon-close]");
  const closeButton = document.querySelector("[data-menu-close]");
  const menuLinks = document.querySelectorAll("[data-mobile-shell] a");
  const themeToggle = document.querySelector("[data-theme-toggle]");

  const setTheme = (theme) => {
    document.documentElement.classList.toggle("dark", theme === "dark");
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("theme", theme);
  };

  const setMenuState = (isOpen) => {
    if (!(toggle instanceof HTMLButtonElement) || !(shell instanceof HTMLDivElement)) {
      return;
    }

    shell.classList.toggle("hidden", !isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));

    if (openIcon instanceof SVGElement) {
      openIcon.classList.toggle("hidden", isOpen);
    }

    if (closeIcon instanceof SVGElement) {
      closeIcon.classList.toggle("hidden", !isOpen);
    }
  };

  if (toggle instanceof HTMLButtonElement) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setMenuState(!isOpen);
    });
  }

  if (closeButton instanceof HTMLButtonElement) {
    closeButton.addEventListener("click", () => setMenuState(false));
  }

  menuLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuState(false));
  });

  if (themeToggle instanceof HTMLButtonElement) {
    themeToggle.addEventListener("click", () => {
      const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
      setTheme(nextTheme);
    });
  }
</script>
