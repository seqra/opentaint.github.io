---
/**
 * Declares the consent defaults and starts the Google tag.
 *
 * The script is bundled rather than inlined: since the runtime injects gtag.js
 * itself, right after declaring the defaults, nothing can load ahead of them —
 * so there is no ordering left to protect in markup, and the logic can stay in
 * type-checked modules.
 */
---

<script>
  import { initConsent } from "@/lib/consent-runtime";

  initConsent();
</script>
