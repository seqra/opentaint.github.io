---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/astro/SiteHeader.astro";
import LandingFooter from "@/components/astro/LandingFooter.astro";
import { AnimatedHero } from "@/components/AnimatedHero";
import { FirstScanFunnel } from "@/components/FirstScanFunnel";
import Demo from "@/components/astro/Demo.astro";
import TheEconomics from "@/components/astro/TheEconomics.astro";
import BestOfBothWorlds from "@/components/astro/BestOfBothWorlds.astro";
import SecurityDebt from "@/components/astro/SecurityDebt.astro";
import WhatIsOpenTaint from "@/components/astro/WhatIsOpenTaint.astro";
import EngineProof from "@/components/astro/EngineProof.astro";
import AgentSkills from "@/components/astro/AgentSkills.astro";
import SupportedTechnology from "@/components/astro/SupportedTechnology.astro";
import FAQ from "@/components/astro/FAQ.astro";
import MobileRailNavigation from "@/components/astro/MobileRailNavigation.astro";
import { defaultKeywords, siteConfig } from "@/lib/site";
import { faqItems } from "@/lib/faq";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.title,
    alternateName: ["opentaint", "opentaint.org"],
    url: siteConfig.url,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.title,
    url: siteConfig.url,
    logo: `${siteConfig.url}/logo.png`,
    sameAs: [
      siteConfig.github,
      siteConfig.discord,
      "https://x.com/opentaint",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.title,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Agentic application security testing and static analysis",
    operatingSystem: "Linux, macOS, Windows",
    description: siteConfig.description,
    url: siteConfig.url,
    downloadUrl: "https://github.com/seqra/opentaint/releases",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    isAccessibleForFree: true,
    codeRepository: siteConfig.github,
    featureList: [
      "Agent-led application security reviews",
      "Repeatable vulnerability checks in CI/CD",
      "GitHub Actions and GitLab CI integrations",
      "Inter-procedural taint analysis",
      "Cross-endpoint and persistence flow tracking",
      "Semgrep-compatible AST-pattern rules",
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    author: {
      "@type": "Organization",
      name: siteConfig.author,
      url: siteConfig.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems
      .filter((item) => !item.isContact && item.answer)
      .map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
  },
];
---

<BaseLayout
  title="OpenTaint: Continuous Vulnerability Checks from Security Reviews"
  description={siteConfig.description}
  imageAlt="OpenTaint"
  keywords={defaultKeywords}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background flex flex-col">
    <SiteHeader />
    <main id="main" class="landing-sections flex-1 pt-16">
      <div class="hero-workflow-group">
        <div class="hero-workflow-signal-field" aria-hidden="true"></div>

        <section class="band hero-band">
          <AnimatedHero />
        </section>

        <BestOfBothWorlds />

        <TheEconomics />
      </div>

      <Demo />

      <FirstScanFunnel client:visible />

      <SecurityDebt />

      <WhatIsOpenTaint />

      <EngineProof />

      <AgentSkills />

      <SupportedTechnology />

      <FAQ />

      <div class="frame-x">
        <LandingFooter />
      </div>
    </main>
    <MobileRailNavigation />
  </div>
</BaseLayout>
