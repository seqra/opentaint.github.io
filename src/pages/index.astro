---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/astro/SiteHeader.astro";
import LandingFooter from "@/components/astro/LandingFooter.astro";
import { AnimatedHero } from "@/components/AnimatedHero";
import Demo from "@/components/astro/Demo.astro";
import TheEconomics from "@/components/astro/TheEconomics.astro";
import SecurityDebt from "@/components/astro/SecurityDebt.astro";
import WhatIsOpenTaint from "@/components/astro/WhatIsOpenTaint.astro";
import AnalysisEngine from "@/components/astro/AnalysisEngine.astro";
import EngineProof from "@/components/astro/EngineProof.astro";
import AgentSkills from "@/components/astro/AgentSkills.astro";
import SupportedTechnology from "@/components/astro/SupportedTechnology.astro";
import FAQ from "@/components/astro/FAQ.astro";
import { defaultKeywords, siteConfig } from "@/lib/site";
import { faqItems } from "@/lib/faq";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.title,
    alternateName: ["opentaint", "opentaint.org"],
    url: siteConfig.url,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.title,
    url: siteConfig.url,
    logo: `${siteConfig.url}/logo.png`,
    sameAs: [
      siteConfig.github,
      siteConfig.discord,
      "https://twitter.com/seqradev",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.title,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows",
    description: "The open source taint analysis engine for the AI era. Powered by formal inter-procedural dataflow analysis. Customizable and self-hosted, built so AI agents drive your application security analysis without burning tokens on every scan. An AI-ready open source alternative to Semgrep Pro and CodeQL.",
    url: siteConfig.url,
    downloadUrl: "https://github.com/seqra/opentaint/releases",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    author: {
      "@type": "Organization",
      name: siteConfig.author,
      url: siteConfig.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems
      .filter((item) => !item.isContact && item.answer)
      .map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
  },
];
---

<BaseLayout
  title="OpenTaint | Turn One Security Review into Unlimited Security Scans"
  description="OpenTaint turns agent security reviews into taint rules and dependency models, then uses formal analysis to scan the whole codebase whenever a scan runs."
  keywords={defaultKeywords}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background flex flex-col">
    <SiteHeader />
    <main id="main" class="landing-sections flex-1 pt-16">
      <section class="band hero-band">
        <AnimatedHero client:load />
      </section>

      <Demo />

      <TheEconomics />

      <SecurityDebt />

      <WhatIsOpenTaint />

      <AnalysisEngine />

      <EngineProof />

      <AgentSkills />

      <SupportedTechnology />

      <FAQ />

      <div class="frame-x">
        <LandingFooter />
      </div>
    </main>
  </div>
</BaseLayout>
