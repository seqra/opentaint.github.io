---
const roadmap = [
  { name: "Python", logo: "/pictures/python-logo.svg" },
  { name: "Go", logo: "/pictures/go-logo.svg" },
  { name: "C#", logo: "/pictures/csharp-logo.svg" },
  { name: "JavaScript", logo: "/pictures/javascript-logo.svg" },
  { name: "TypeScript", logo: "/pictures/typescript-logo.svg" },
];

const springCoverage = ["MVC", "Data", "WebFlux", "JPA"];
---

<section class="band technology-band" aria-labelledby="technology-heading">
  <div class="mx-auto max-w-6xl">
    <div class="section-header">
      <p class="section-eyebrow">Analysis coverage</p>
      <h2 id="technology-heading" class="section-heading">Supported languages and frameworks</h2>
    </div>

    <div class="section-content overflow-hidden rounded-xl border border-border-strong bg-background shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border bg-code-header px-6 py-4 sm:px-8">
        <p class="flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-foreground">
          <span class="h-2 w-2 rounded-full bg-primary shadow-[0_0_0_4px_hsl(var(--brand)/0.1)]" aria-hidden="true"></span>
          Available today
        </p>
        <span class="font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">JVM analysis</span>
      </div>

      <div class="divide-y divide-border" role="list" aria-label="Available analysis coverage">
        <article class="grid gap-6 px-6 py-8 sm:px-8 lg:grid-cols-[9rem_minmax(0,1fr)_auto] lg:items-center lg:gap-8" role="listitem">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">Languages</p>

          <div class="flex min-w-0 items-center gap-6">
            <div class="flex shrink-0 items-center" aria-hidden="true">
              <span class="flex h-14 w-14 items-center justify-center rounded-full border border-border bg-white shadow-sm">
                <img src="/pictures/java-logo.svg" alt="" class="h-10 w-10 object-contain" />
              </span>
              <span class="-ml-2 flex h-14 w-14 items-center justify-center rounded-full border border-border bg-white shadow-sm">
                <img src="/pictures/kotlin-logo.svg" alt="" class="h-10 w-10 object-contain" />
              </span>
            </div>
            <div class="min-w-0">
              <h3 class="font-mono text-lg font-semibold text-foreground sm:text-xl">Java + Kotlin</h3>
              <p class="mt-1 font-mono text-[11px] leading-5 text-muted-foreground sm:text-xs">Analyzed together in one JVM dataflow graph.</p>
            </div>
          </div>

          <span class="w-fit rounded-full border border-primary/40 bg-primary/[0.07] px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-primary">Supported</span>
        </article>

        <article class="grid gap-6 px-6 py-8 sm:px-8 lg:grid-cols-[9rem_minmax(0,1fr)_auto] lg:items-center lg:gap-8" role="listitem">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">Framework</p>

          <div class="min-w-0">
            <img src="/pictures/spring-boot-logo.svg" alt="Spring Boot" class="h-10 w-auto max-w-[13rem] sm:h-12 sm:max-w-[15rem]" />
            <ul class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[10px] font-semibold text-muted-foreground sm:text-[11px]" aria-label="Spring framework coverage">
              {springCoverage.map((item, index) => (
                <li class="flex items-center gap-3">
                  {index > 0 && <span class="h-1 w-1 rounded-full bg-primary" aria-hidden="true"></span>}
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap items-center gap-4 lg:flex-col lg:items-end lg:gap-3">
            <span class="w-fit rounded-full border border-primary/40 bg-primary/[0.07] px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-primary">Deep support</span>
            <a href="/blog/spring-analyzer/" class="font-mono text-[10px] font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-foreground">
              Explore analysis
            </a>
          </div>
        </article>
      </div>

      <section class="border-t border-border bg-code-bg px-6 py-8 sm:px-8" aria-labelledby="technology-roadmap-heading">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">Roadmap</p>
            <h3 id="technology-roadmap-heading" class="mt-2 font-mono text-base font-semibold text-foreground sm:text-lg">More languages</h3>
          </div>
          <span class="shrink-0 rounded-full border border-border-strong bg-background px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">Planned</span>
        </div>

        <div class="relative mt-8">
          <span class="absolute left-5 right-5 top-6 hidden h-px bg-border-strong sm:block" aria-hidden="true"></span>
          <ul class="relative grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-5 sm:gap-4" aria-label="Planned language support">
            {roadmap.map((item) => (
              <li class="flex items-center gap-3 sm:flex-col sm:gap-3 sm:text-center">
                <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-border-strong bg-white shadow-sm">
                  <img src={item.logo} alt="" class="h-8 w-8 object-contain" />
                </span>
                <span class="font-mono text-[10px] font-semibold text-foreground">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </div>
</section>
